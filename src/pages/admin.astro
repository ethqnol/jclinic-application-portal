---
import Layout from '../layouts/Layout.astro';
import { getSession, isAdmin } from '../lib/auth';
import { AdminService } from '../lib/services/adminService';
import { getApplicationStatus } from '../lib/application-status';

const session = await getSession(Astro);
if (!session) {
  return Astro.redirect('/');
}

const db = Astro.locals.runtime?.env?.DB;
if (!db) {
  return Astro.redirect('/?error=db_error');
}

const userIsAdmin = await isAdmin(session.user.email, db);
if (!userIsAdmin) {
  return Astro.redirect('/dashboard');
}

const applications = await AdminService.getAllApplications(db);
const admins = await AdminService.getAllAdmins(db);
const applicationsOpen = await getApplicationStatus(db);

const gradeColors: Record<number, string> = {
	1: '#DC2626',
	2: '#EA580C',
	3: '#475569',
	4: '#0D9488',
	5: '#16A34A'
};
---

<Layout title="Admin Console - Application Portal" session={session} userRole="admin">
	<div class="container" style="max-width: 1140px;">
		
		<!-- Admin Header Bar -->
		<div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
			<div>
				<h2 style="font-size: 2rem; font-weight: 800; color: var(--slate-900); margin-bottom: 0.25rem;">
					Admin Console
				</h2>
				<p style="color: var(--slate-600); margin: 0; font-size: 0.95rem;">
					Manage applicant evaluations, system settings, and administrator access.
				</p>
			</div>

			<div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
				<a href="/api/export-csv" class="btn btn-secondary btn-sm">
					Export CSV
				</a>

				<button id="toggle-apps-btn" class="btn btn-secondary btn-sm">
					{applicationsOpen ? 'Close Applications' : 'Open Applications'}
				</button>
			</div>
		</div>

		<!-- Nav Tabs: Review Console vs Config -->
		<div style="display: flex; gap: 0.5rem; border-bottom: 1px solid var(--slate-200); margin-bottom: 1.75rem;">
			<button id="tab-review-btn" class="btn btn-secondary btn-sm tab-btn active" style="border-bottom-left-radius: 0; border-bottom-right-radius: 0; margin-bottom: -1px;">
				Review Console
			</button>
			<button id="tab-config-btn" class="btn btn-secondary btn-sm tab-btn" style="border-bottom-left-radius: 0; border-bottom-right-radius: 0; margin-bottom: -1px;">
				Config
			</button>
		</div>

		<!-- SECTION 1: REVIEW CONSOLE TAB -->
		<div id="section-review">
			<!-- Summary Stats -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.75rem;">
				<div class="card-clean" style="padding: 1.25rem; margin: 0;">
					<span style="font-size: 0.75rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Total Submitted</span>
					<div style="font-size: 2rem; font-weight: 800; color: var(--slate-900); margin-top: 0.2rem;">
						{applications.length}
					</div>
				</div>

				<div class="card-clean" style="padding: 1.25rem; margin: 0;">
					<span style="font-size: 0.75rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Reviewed & Rated</span>
					<div style="font-size: 2rem; font-weight: 800; color: var(--success-green); margin-top: 0.2rem;">
						{applications.filter((a: any) => a.reviewer_grade !== null).length}
					</div>
				</div>

				<div class="card-clean" style="padding: 1.25rem; margin: 0;">
					<span style="font-size: 0.75rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Awaiting Review</span>
					<div style="font-size: 2rem; font-weight: 800; color: var(--warning-amber); margin-top: 0.2rem;">
						{applications.filter((a: any) => a.reviewer_grade === null).length}
					</div>
				</div>
			</div>

			<!-- Applications Table -->
			<div class="card-clean" style="padding: 0; overflow: hidden;">
				<div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--slate-200); background: var(--slate-50); display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--slate-800); margin: 0;">
						Applications List
					</h3>
					<input
						type="text"
						id="search-input"
						placeholder="Search by name or email..."
						class="input-field"
						style="max-width: 280px; padding: 0.4rem 0.75rem; font-size: 0.85rem;"
					/>
				</div>

				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;">
						<thead>
							<tr style="background: var(--slate-100); border-bottom: 1px solid var(--slate-200); color: var(--slate-600); font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.04em;">
								<th style="padding: 0.75rem 1.25rem;">Applicant</th>
								<th style="padding: 0.75rem 1rem;">Location</th>
								<th style="padding: 0.75rem 1rem;">Rec Letter</th>
								<th style="padding: 0.75rem 1rem;">Fin. Aid</th>
								<th style="padding: 0.75rem 1rem;">Rating</th>
								<th style="padding: 0.75rem 1.25rem; text-align: right;">Action</th>
							</tr>
						</thead>
						<tbody id="applications-body">
							{applications.map((app: any) => {
								const experienceData = JSON.parse(app.experience_data || '{}');
								const grade = app.reviewer_grade;
								const gradeColor = grade ? gradeColors[grade] : '#64748B';
								const locDetail = experienceData.location_detail;
								
								let displayLoc = 'Massachusetts';
								if (app.student_location === 'out_of_state') {
									displayLoc = locDetail ? `Out of State (${locDetail})` : 'Out of State (US)';
								} else if (app.student_location === 'international') {
									displayLoc = locDetail ? `International (${locDetail})` : 'International';
								}

								const isFlagged = app.is_suspicious_submission === 1;
								const isPersonal = app.is_personal_email === 1;

								return (
									<tr class="app-row" data-search={`${app.user_name} ${app.user_email} ${app.first_name} ${app.last_name} ${displayLoc}`} style="border-bottom: 1px solid var(--slate-200);">
										<td style="padding: 0.85rem 1.25rem;">
											<div style="font-weight: 700; color: var(--slate-900);">{app.first_name || app.user_name} {app.last_name || ''}</div>
											<div style="font-size: 0.8rem; color: var(--slate-500);">{app.preferred_email || app.user_email}</div>
										</td>
										<td style="padding: 0.85rem 1rem; color: var(--slate-700); font-weight: 500;">
											{displayLoc}
										</td>
										<td style="padding: 0.85rem 1rem;">
											{app.rec_is_submitted ? (
												<div>
													<span class="badge-pill pill-success">
														Received ✓
													</span>
													{isFlagged && (
														<div style="font-size: 0.725rem; color: #DC2626; font-weight: 700; margin-top: 0.2rem; display: flex; align-items: center; gap: 0.2rem;">
															<span>⚠️ Flagged: Device Match</span>
														</div>
													)}
													{isPersonal && !isFlagged && (
														<div style="font-size: 0.725rem; color: #D97706; font-weight: 600; margin-top: 0.2rem;">
															Notice: Personal Webmail
														</div>
													)}
												</div>
											) : (
												<span class="badge-pill pill-neutral">Pending</span>
											)}
										</td>
										<td style="padding: 0.85rem 1rem;">
											{app.needs_financial_aid ? (
												<span class="badge-pill pill-warning">Yes</span>
											) : (
												<span class="badge-pill pill-neutral">No</span>
											)}
										</td>
										<td style="padding: 0.85rem 1rem;">
											{grade ? (
												<span style={`background: ${gradeColor}15; color: ${gradeColor}; border: 1px solid ${gradeColor}30; padding: 0.2rem 0.55rem; border-radius: var(--radius-full); font-size: 0.775rem; font-weight: 700;`}>
													Rating {grade}/5
												</span>
											) : (
												<span style="color: var(--slate-400); font-size: 0.8rem; font-style: italic;">Unrated</span>
											)}
										</td>
										<td style="padding: 0.85rem 1.25rem; text-align: right;">
											<button
												class="btn btn-primary btn-sm review-btn"
												data-app={JSON.stringify(app)}
												data-loc={displayLoc}
											>
												Review & Rate
											</button>
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- SECTION 2: CONFIG TAB -->
		<div id="section-config" style="display: none;">
			
			<div class="card-clean" style="margin-bottom: 1.75rem;">
				<h3 style="font-size: 1.25rem; font-weight: 700; color: var(--slate-900); margin-bottom: 0.5rem;">
					Add New Administrator
				</h3>
				<p style="color: var(--slate-600); font-size: 0.9rem; margin-bottom: 1.25rem;">
					Grant full administrator access to another Google account email.
				</p>

				<form id="add-admin-form" style="display: flex; gap: 0.75rem; max-width: 500px; align-items: center;">
					<input
						type="email"
						id="new-admin-email"
						placeholder="user@example.com"
						class="input-field"
						required
					/>
					<button type="submit" class="btn btn-primary" style="white-space: nowrap;">
						Add Admin
					</button>
				</form>
				<div id="add-admin-status" style="margin-top: 0.75rem; font-size: 0.85rem;"></div>
			</div>

			<!-- Current Admins List -->
			<div class="card-clean" style="padding: 0; overflow: hidden; margin-bottom: 2rem;">
				<div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--slate-200); background: var(--slate-50);">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--slate-800); margin: 0;">
						Active Administrators ({admins.length})
					</h3>
				</div>

				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;">
						<thead>
							<tr style="background: var(--slate-100); border-bottom: 1px solid var(--slate-200); color: var(--slate-600); font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.04em;">
								<th style="padding: 0.75rem 1.25rem;">Admin Email</th>
								<th style="padding: 0.75rem 1rem;">Added Date</th>
								<th style="padding: 0.75rem 1.25rem; text-align: right;">Action</th>
							</tr>
						</thead>
						<tbody>
							{admins.map((adm: any) => {
								const isSelf = adm.email.toLowerCase() === session.user.email.toLowerCase();
								return (
									<tr style="border-bottom: 1px solid var(--slate-200);">
										<td style="padding: 0.85rem 1.25rem; font-weight: 600; color: var(--slate-900);">
											{adm.email}
											{isSelf && <span class="badge-pill pill-neutral" style="margin-left: 0.5rem; font-size: 0.7rem;">(You)</span>}
										</td>
										<td style="padding: 0.85rem 1rem; color: var(--slate-600); font-size: 0.825rem;">
											{adm.created_at ? new Date(adm.created_at).toLocaleDateString() : 'Baseline'}
										</td>
										<td style="padding: 0.85rem 1.25rem; text-align: right;">
											<button
												class="btn btn-secondary btn-sm remove-admin-btn"
												data-email={adm.email}
												disabled={isSelf}
												title={isSelf ? "You cannot demote yourself" : "Demote Admin"}
												style={isSelf ? "opacity: 0.5; cursor: not-allowed;" : ""}
											>
												Demote / Remove
											</button>
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</div>

			<!-- DANGER ZONE: DATABASE WIPE -->
			<div class="card-clean" style="border: 2px solid #FCA5A5; background: #FEF2F2; padding: 1.75rem;">
				<h3 style="font-size: 1.25rem; font-weight: 800; color: #991B1B; margin-bottom: 0.5rem;">
					Danger Zone: Database Wipe
				</h3>
				<p style="color: #7F1D1D; font-size: 0.9rem; margin-bottom: 1.25rem; line-height: 1.5;">
					This action permanently deletes all submitted applications and non-admin applicant user data. <strong>Administrator accounts and system access will be preserved.</strong>
				</p>

				<div style="background: #FFFFFF; padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid #FECDD3; max-width: 600px;">
					<label class="form-label" for="wipe-confirm-input" style="color: #991B1B; font-size: 0.85rem;">
						Security Check: Type <code>DELETE ALL APPLICATIONS AND USERS</code> to enable wipe:
					</label>
					<input
						type="text"
						id="wipe-confirm-input"
						placeholder="DELETE ALL APPLICATIONS AND USERS"
						class="input-field"
						style="margin-bottom: 1rem; font-family: monospace;"
					/>

					<button id="open-wipe-modal-btn" class="btn btn-primary btn-sm" disabled style="background-color: #DC2626; opacity: 0.5; cursor: not-allowed; width: 100%;">
						Initiate Database Wipe
					</button>
				</div>
			</div>

		</div>

	</div>

	<!-- Review Modal -->
	<div id="review-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 1000; align-items: center; justify-content: center; padding: 1.5rem;">
		<div class="card-clean" style="max-width: 820px; width: 100%; max-height: 88vh; overflow-y: auto; padding: 2rem; position: relative; margin: 0;">
			
			<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; border-bottom: 1px solid var(--slate-200); padding-bottom: 0.85rem;">
				<div>
					<h3 id="modal-applicant-name" style="font-size: 1.35rem; font-weight: 800; color: var(--slate-900); margin-bottom: 0.2rem;">Applicant Details</h3>
					<p id="modal-applicant-email" style="color: var(--slate-500); font-size: 0.875rem; margin: 0;"></p>
				</div>
				<button id="close-modal-btn" class="btn btn-secondary btn-sm">Close Window</button>
			</div>

			<!-- Background Pill Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.85rem; margin-bottom: 1.5rem; background: var(--slate-50); padding: 0.85rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--slate-200);">
				<div>
					<span style="font-size: 0.725rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Location</span>
					<div id="modal-location" style="font-weight: 700; color: var(--slate-800); font-size: 0.9rem;"></div>
				</div>
				<div>
					<span style="font-size: 0.725rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Grade Level</span>
					<div id="modal-grade" style="font-weight: 700; color: var(--slate-800); font-size: 0.9rem;"></div>
				</div>
				<div>
					<span style="font-size: 0.725rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Coding Level</span>
					<div id="modal-coding" style="font-weight: 700; color: var(--slate-800); font-size: 0.9rem;"></div>
				</div>
				<div>
					<span style="font-size: 0.725rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Financial Aid</span>
					<div id="modal-finaid" style="font-weight: 700; color: var(--slate-800); font-size: 0.9rem;"></div>
				</div>
			</div>

			<!-- Parent / Guardian Information Section -->
			<div style="margin-bottom: 1.25rem; background: var(--slate-50); padding: 0.85rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--slate-200);">
				<h4 style="font-size: 0.85rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase; margin-bottom: 0.4rem;">Parent / Guardian Contact</h4>
				<div id="modal-parent-info" style="font-size: 0.875rem; color: var(--slate-800); font-weight: 500;"></div>
			</div>

			<!-- Recommendation Letter Section -->
			<div style="margin-bottom: 1.25rem; background: var(--slate-50); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--slate-200);">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
					<h4 style="font-size: 0.85rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase; margin: 0;">Recommendation Letter</h4>
					<div style="display: flex; gap: 0.4rem; align-items: center;">
						<span id="modal-rec-badge" class="badge-pill pill-neutral"></span>
					</div>
				</div>

				<!-- Audit Reason Box -->
				<div id="modal-audit-box" style="display: none; background: #FEF2F2; border: 1px solid #FECDD3; border-radius: var(--radius-sm); padding: 0.85rem; margin-bottom: 0.85rem;">
					<div style="font-weight: 700; color: #991B1B; font-size: 0.85rem; margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.3rem;">
						<span>⚠️ Flagged Audit Details & Explanation:</span>
					</div>
					<ul id="modal-audit-list" style="margin: 0; padding-left: 1.25rem; font-size: 0.8rem; color: #7F1D1D; line-height: 1.5;"></ul>
				</div>

				<div id="modal-rec-meta" style="font-size: 0.875rem; color: var(--slate-800); font-weight: 500; margin-bottom: 0.6rem;"></div>
				<div id="modal-rec-text" style="background: #FFFFFF; padding: 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--slate-200); font-size: 0.875rem; color: var(--slate-800); white-space: pre-wrap; line-height: 1.5; max-height: 200px; overflow-y: auto;"></div>
			</div>

			<!-- Skills & ML Section -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.25rem;">
				<div style="background: var(--slate-50); padding: 0.85rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--slate-200);">
					<span style="font-size: 0.725rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">Languages</span>
					<div id="modal-languages" style="font-weight: 600; color: var(--slate-800); font-size: 0.875rem;"></div>
				</div>
				<div style="background: var(--slate-50); padding: 0.85rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--slate-200);">
					<span style="font-size: 0.725rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase;">ML Technologies</span>
					<div id="modal-ml-tech" style="font-weight: 600; color: var(--slate-800); font-size: 0.875rem;"></div>
				</div>
			</div>

			<!-- Essays -->
			<div style="margin-bottom: 1.25rem;">
				<h4 style="font-size: 0.95rem; font-weight: 700; color: var(--brand-blue); margin-bottom: 0.4rem;">Essay 1: Background & Motivation</h4>
				<div id="modal-essay-one" style="background: var(--slate-50); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--slate-200); font-size: 0.9rem; line-height: 1.6; white-space: pre-wrap; color: var(--slate-800);"></div>
			</div>

			<div style="margin-bottom: 1.5rem;">
				<h4 style="font-size: 0.95rem; font-weight: 700; color: var(--brand-blue); margin-bottom: 0.4rem;">Essay 2: Goals & Career Path</h4>
				<div id="modal-essay-two" style="background: var(--slate-50); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--slate-200); font-size: 0.9rem; line-height: 1.6; white-space: pre-wrap; color: var(--slate-800);"></div>
			</div>

			<div style="margin-bottom: 1.5rem;">
				<h4 style="font-size: 0.95rem; font-weight: 700; color: var(--slate-800); margin-bottom: 0.4rem;">Clubs, Activities & Leadership</h4>
				<div id="modal-clubs" style="background: var(--slate-50); padding: 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--slate-200); font-size: 0.875rem; color: var(--slate-800);"></div>
			</div>

			<!-- Rating Selector -->
			<div style="background: var(--brand-blue-light); border: 1px solid var(--brand-blue-border); padding: 1.25rem; border-radius: var(--radius-md);">
				<h4 style="font-size: 1rem; font-weight: 700; color: var(--brand-blue); margin-bottom: 0.6rem;">
					Admissions Decision Rating (1–5)
				</h4>
				
				<div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.4rem; margin-bottom: 1rem;">
					{[
						{ grade: 1, label: '1 - Strong Reject' },
						{ grade: 2, label: '2 - Weak Reject' },
						{ grade: 3, label: '3 - Neutral' },
						{ grade: 4, label: '4 - Accept' },
						{ grade: 5, label: '5 - Strong Accept' }
					].map((item) => (
						<button
							type="button"
							class="rating-btn btn btn-secondary btn-sm"
							data-grade={item.grade}
							style="white-space: nowrap; font-size: 0.775rem; padding: 0.5rem 0.2rem; justify-content: center;"
						>
							{item.label}
						</button>
					))}
				</div>

				<div class="form-group" style="margin-bottom: 1rem;">
					<label class="form-label" for="modal-notes">Admin Notes & Feedback</label>
					<textarea id="modal-notes" class="textarea-field" rows="3" placeholder="Add confidential evaluation notes..."></textarea>
				</div>

				<button id="save-rating-btn" class="btn btn-primary" style="width: 100%;">
					Save Rating & Notes
				</button>
			</div>

		</div>
	</div>

	<!-- Database Wipe Confirmation Modal -->
	<div id="wipe-modal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.75); z-index: 1000; align-items: center; justify-content: center; padding: 1.5rem;">
		<div class="card-clean" style="max-width: 500px; width: 100%; border: 2px solid #DC2626; padding: 2rem; background: #FFFFFF;">
			<h3 style="font-size: 1.35rem; font-weight: 800; color: #DC2626; margin-bottom: 0.75rem;">
				Final Confirmation: Wipe Database
			</h3>
			<p style="color: var(--slate-700); font-size: 0.925rem; line-height: 1.5; margin-bottom: 1.5rem;">
				You are about to permanently delete <strong>all submitted applications and applicant data</strong>. This action is irreversible.
			</p>
			
			<div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
				<button id="close-wipe-modal-btn" class="btn btn-secondary btn-sm">Cancel</button>
				<button id="confirm-execute-wipe-btn" class="btn btn-primary btn-sm" style="background-color: #DC2626;">
					Yes, Execute Permanent Wipe
				</button>
			</div>
		</div>
	</div>

	<!-- Script -->
	<script is:inline>
		let activeAppId = null;
		let selectedGrade = null;

		// Tab Switching
		const tabReviewBtn = document.getElementById('tab-review-btn');
		const tabConfigBtn = document.getElementById('tab-config-btn');
		const sectionReview = document.getElementById('section-review');
		const sectionConfig = document.getElementById('section-config');

		tabReviewBtn?.addEventListener('click', () => {
			tabReviewBtn.classList.add('active');
			tabConfigBtn.classList.remove('active');
			sectionReview.style.display = 'block';
			sectionConfig.style.display = 'none';
		});

		tabConfigBtn?.addEventListener('click', () => {
			tabConfigBtn.classList.add('active');
			tabReviewBtn.classList.remove('active');
			sectionConfig.style.display = 'block';
			sectionReview.style.display = 'none';
		});

		// Search Filter
		document.getElementById('search-input')?.addEventListener('input', function() {
			const term = this.value.toLowerCase();
			document.querySelectorAll('.app-row').forEach(row => {
				const text = row.getAttribute('data-search')?.toLowerCase() || '';
				row.style.display = text.includes(term) ? '' : 'none';
			});
		});

		// Modal Review Handler
		document.querySelectorAll('.review-btn').forEach(btn => {
			btn.addEventListener('click', function() {
				const app = JSON.parse(this.getAttribute('data-app'));
				const exp = JSON.parse(app.experience_data || '{}');
				const displayLoc = this.getAttribute('data-loc');
				activeAppId = app.id;
				selectedGrade = app.reviewer_grade || null;

				document.getElementById('modal-applicant-name').textContent = `${app.first_name || app.user_name} ${app.last_name || ''}`;
				document.getElementById('modal-applicant-email').textContent = `Email: ${app.preferred_email || app.user_email}`;
				document.getElementById('modal-location').textContent = displayLoc || app.student_location;
				document.getElementById('modal-grade').textContent = exp.grade_level || 'N/A';
				document.getElementById('modal-coding').textContent = exp.programming_experience || 'N/A';
				document.getElementById('modal-finaid').textContent = app.needs_financial_aid ? 'Yes' : 'No';

				// Parent Info
				const pName = exp.parent_name || 'N/A';
				const pEmail = exp.parent_email || 'N/A';
				const pPhone = exp.parent_phone || 'N/A';
				document.getElementById('modal-parent-info').innerHTML = `<strong>Name:</strong> ${pName} &nbsp;|&nbsp; <strong>Email:</strong> ${pEmail} &nbsp;|&nbsp; <strong>Phone:</strong> ${pPhone}`;

				// Recommendation Info & Audit Reasons
				const recBadge = document.getElementById('modal-rec-badge');
				const auditBox = document.getElementById('modal-audit-box');
				const auditList = document.getElementById('modal-audit-list');
				const recMeta = document.getElementById('modal-rec-meta');
				const recText = document.getElementById('modal-rec-text');
				
				const rName = app.recommender_name || exp.recommender_name || 'Not provided';
				const rEmail = app.recommender_email || exp.recommender_email || 'Not provided';
				const rTitle = app.recommender_title || exp.recommender_title || '';
				const isPersonal = app.is_personal_email === 1;
				const isSuspicious = app.is_suspicious_submission === 1;

				if (app.rec_is_submitted) {
					recBadge.className = 'badge-pill pill-success';
					recBadge.textContent = 'Received ✓';
					recText.textContent = app.letter_text || 'Letter text recorded.';
				} else {
					recBadge.className = 'badge-pill pill-neutral';
					recBadge.textContent = 'Pending Submission';
					recText.textContent = 'Recommendation letter has not been submitted yet.';
				}

				// Build Audit Explanations
				const auditReasons = [];
				if (isSuspicious) {
					if (app.user_email && rEmail && app.user_email.toLowerCase().trim() === rEmail.toLowerCase().trim()) {
						auditReasons.push(`Recommender email address (${rEmail}) matches the student's Google account email address.`);
					}
					if (app.applicant_device_fp && app.recommender_device_fp && app.applicant_device_fp === app.recommender_device_fp) {
						auditReasons.push(`Browser hardware device fingerprint (${app.recommender_device_fp}) matches the applicant's computer/browser.`);
					} else {
						auditReasons.push(`Recommendation was submitted from an active browser session logged into the applicant's account.`);
					}
				}
				if (isPersonal) {
					auditReasons.push(`Recommender email (${rEmail}) is a personal webmail address (@gmail.com, @yahoo.com, etc.) rather than an institutional/school domain.`);
				}

				if (auditReasons.length > 0) {
					auditBox.style.display = 'block';
					auditList.innerHTML = auditReasons.map(r => `<li>${r}</li>`).join('');
				} else {
					auditBox.style.display = 'none';
					auditList.innerHTML = '';
				}

				let warningText = isPersonal ? ' &nbsp;<span style="color: #D97706; font-size: 0.775rem; font-weight: 600;">(Notice: Personal Webmail Address)</span>' : '';
				recMeta.innerHTML = `<strong>Name:</strong> ${rName} ${rTitle ? `(${rTitle})` : ''} &nbsp;|&nbsp; <strong>Email:</strong> ${rEmail}${warningText}`;

				// Tech & ML
				document.getElementById('modal-languages').textContent = (exp.languages && exp.languages.length) ? exp.languages.join(', ') : 'None';
				document.getElementById('modal-ml-tech').textContent = (exp.ml_technologies && exp.ml_technologies.length) ? exp.ml_technologies.join(', ') : 'None';

				document.getElementById('modal-essay-one').textContent = app.essay_one || 'No response provided.';
				document.getElementById('modal-essay-two').textContent = app.essay_two || 'No response provided.';
				document.getElementById('modal-clubs').textContent = exp.clubs_activities || 'None listed.';
				document.getElementById('modal-notes').value = app.reviewer_notes || '';

				updateRatingButtons();
				document.getElementById('review-modal').style.display = 'flex';
			});
		});

		function updateRatingButtons() {
			document.querySelectorAll('.rating-btn').forEach(b => {
				const g = parseInt(b.getAttribute('data-grade'));
				if (g === selectedGrade) {
					b.style.background = 'var(--brand-blue)';
					b.style.color = '#FFFFFF';
					b.style.borderColor = 'var(--brand-blue)';
				} else {
					b.style.background = '#FFFFFF';
					b.style.color = 'var(--slate-700)';
					b.style.borderColor = 'var(--slate-300)';
				}
			});
		}

		document.querySelectorAll('.rating-btn').forEach(b => {
			b.addEventListener('click', function() {
				selectedGrade = parseInt(this.getAttribute('data-grade'));
				updateRatingButtons();
			});
		});

		document.getElementById('close-modal-btn')?.addEventListener('click', () => {
			document.getElementById('review-modal').style.display = 'none';
		});

		document.getElementById('save-rating-btn')?.addEventListener('click', async function() {
			if (!activeAppId) return;
			if (!selectedGrade) {
				alert('Please select a rating between 1 and 5');
				return;
			}

			const notes = document.getElementById('modal-notes').value;
			try {
				const res = await fetch('/api/admin/save-review', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ applicationId: activeAppId, grade: selectedGrade, notes })
				});

				if (res.ok) {
					location.reload();
				} else {
					const data = await res.json();
					alert('Error saving rating: ' + (data.error || 'Unknown error'));
				}
			} catch (e) {
				alert('Error saving rating. Please try again.');
			}
		});

		document.getElementById('toggle-apps-btn')?.addEventListener('click', async function() {
			try {
				const res = await fetch('/api/admin/toggle-applications', { method: 'POST' });
				if (res.ok) location.reload();
			} catch (e) {
				alert('Error toggling applications status');
			}
		});

		// Add Admin Handler
		document.getElementById('add-admin-form')?.addEventListener('submit', async function(e) {
			e.preventDefault();
			const emailInput = document.getElementById('new-admin-email');
			const statusDiv = document.getElementById('add-admin-status');
			const email = emailInput.value.trim();

			try {
				const res = await fetch('/api/admin/add-admin', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email })
				});
				const data = await res.json();

				if (res.ok) {
					statusDiv.style.color = 'var(--success-green)';
					statusDiv.textContent = data.message;
					setTimeout(() => location.reload(), 1000);
				} else {
					statusDiv.style.color = '#DC2626';
					statusDiv.textContent = data.error || 'Failed to add admin';
				}
			} catch (err) {
				statusDiv.style.color = '#DC2626';
				statusDiv.textContent = 'Network error while adding admin';
			}
		});

		// Remove Admin Handler
		document.querySelectorAll('.remove-admin-btn').forEach(btn => {
			btn.addEventListener('click', async function() {
				const email = this.getAttribute('data-email');
				if (confirm(`Are you sure you want to demote ${email} and remove their admin privileges?`)) {
					try {
						const res = await fetch('/api/admin/remove-admin', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ email })
						});
						if (res.ok) {
							location.reload();
						} else {
							const data = await res.json();
							alert('Error removing admin: ' + (data.error || 'Unknown error'));
						}
					} catch (err) {
						alert('Error removing admin');
					}
				}
			});
		});

		// Multi-Layer Database Wipe Logic
		const EXPECTED_WIPE_PHRASE = "DELETE ALL APPLICATIONS AND USERS";
		const wipeInput = document.getElementById('wipe-confirm-input');
		const openWipeModalBtn = document.getElementById('open-wipe-modal-btn');
		const wipeModal = document.getElementById('wipe-modal');
		const closeWipeModalBtn = document.getElementById('close-wipe-modal-btn');
		const confirmExecuteWipeBtn = document.getElementById('confirm-execute-wipe-btn');

		wipeInput?.addEventListener('input', function() {
			if (this.value.trim() === EXPECTED_WIPE_PHRASE) {
				openWipeModalBtn.disabled = false;
				openWipeModalBtn.style.opacity = '1';
				openWipeModalBtn.style.cursor = 'pointer';
			} else {
				openWipeModalBtn.disabled = true;
				openWipeModalBtn.style.opacity = '0.5';
				openWipeModalBtn.style.cursor = 'not-allowed';
			}
		});

		openWipeModalBtn?.addEventListener('click', function() {
			if (wipeInput.value.trim() === EXPECTED_WIPE_PHRASE) {
				wipeModal.style.display = 'flex';
			}
		});

		closeWipeModalBtn?.addEventListener('click', function() {
			wipeModal.style.display = 'none';
		});

		confirmExecuteWipeBtn?.addEventListener('click', async function() {
			const confirmPhrase = wipeInput.value.trim();
			try {
				const res = await fetch('/api/admin/wipe-database', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ confirmPhrase })
				});

				if (res.ok) {
					alert('Database successfully wiped.');
					location.reload();
				} else {
					const data = await res.json();
					alert('Error wiping database: ' + (data.error || 'Unknown error'));
				}
			} catch (err) {
				alert('Network error while executing database wipe');
			}
		});
	</script>
</Layout>