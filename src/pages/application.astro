                                        <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--brand-blue); margin: 0;">2. Background & Technical Skills</h4>
                                        <button type="button" class="btn btn-secondary btn-sm goto-step-btn" data-target="2" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">Edit Section 2</button>
                                    </div>
                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; font-size: 0.875rem; margin-bottom: 0.75rem;">
                                        <div><strong>Grade Level:</strong> <span id="rev-grade">-</span></div>
                                        <div><strong>Coding Level:</strong> <span id="rev-prog-exp">-</span></div>
                                        <div><strong>Financial Aid Needed:</strong> <span id="rev-aid">-</span></div>
                                        <div><strong>Research Experience:</strong> <span id="rev-research">-</span></div>
                                    </div>
                                    <div style="font-size: 0.875rem; margin-bottom: 0.5rem;">
                                        <strong>Languages:</strong> <span id="rev-languages">-</span>
                                    </div>
                                    <div style="font-size: 0.875rem;">
                                        <strong>ML Frameworks:</strong> <span id="rev-ml">-</span>
                                    </div>
                                </div>

                                <!-- Essays Summary Card -->
                                <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-sm); padding: 1.25rem;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 1px solid var(--slate-200); padding-bottom: 0.5rem;">
                                        <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--brand-blue); margin: 0;">3. Essays Summary</h4>
                                        <button type="button" class="btn btn-secondary btn-sm goto-step-btn" data-target="3" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">Edit Section 3</button>
                                    </div>
                                    <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.875rem;">
                                        <div>
                                            <strong>Essay 1 Status:</strong> <span id="rev-essay1-status">-</span>
                                            <p id="rev-essay1-preview" style="font-style: italic; color: var(--slate-600); margin-top: 0.25rem; font-size: 0.825rem; max-height: 60px; overflow: hidden; text-overflow: ellipsis;"></p>
                                        </div>
                                        <div>
                                            <strong>Essay 2 Status:</strong> <span id="rev-essay2-status">-</span>
                                            <p id="rev-essay2-preview" style="font-style: italic; color: var(--slate-600); margin-top: 0.25rem; font-size: 0.825rem; max-height: 60px; overflow: hidden; text-overflow: ellipsis;"></p>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <button
                                type="submit"
                                class="btn btn-primary"
                                style="width: 100%; padding: 0.85rem;"
                                disabled={!applicationsOpen}
