---
import Layout from "../layouts/Layout.astro";
import { getSession, getUserRole, type Session } from "../lib/auth";
import { getApplicationStatus, calculateDraftSectionStatuses } from "../lib/application-status";
import { isDevTestRequest } from "../lib/dev-test";

const isTestMode = isDevTestRequest(Astro.locals, Astro.url);

const TEST_SESSION: Session = {
    user: {
        id: "dev-test-user",
        email: "test@example.com",
        name: "Test Applicant",
        first_name: "Test",
        last_name: "Applicant",
        preferred_email: "test@example.com",
    },
};

let session: Session | null = null;
let userRole: "admin" | "user" = "user";
let applicationsOpen = true;
let existingApplication: any = null;
let currentUser = TEST_SESSION.user;
let draftData: any = {};

if (isTestMode) {
    session = TEST_SESSION;
    currentUser = TEST_SESSION.user;
} else {
    session = await getSession(Astro);
    if (!session) {
        return Astro.redirect("/");
    }

    const db = Astro.locals.runtime?.env?.DB;
    userRole = db ? await getUserRole(session.user.email, db) : "user";
    applicationsOpen = db ? await getApplicationStatus(db) : true;
    currentUser = session.user;

    if (db) {
        existingApplication = await db
            .prepare("SELECT * FROM applications WHERE user_id = ?")
            .bind(session.user.id)
            .first();

        const dbUser: any = await db
            .prepare("SELECT * FROM users WHERE id = ?")
            .bind(session.user.id)
            .first();

        if (dbUser) {
            currentUser = {
                id: String(dbUser.id),
                email: String(dbUser.email || ""),
                name: String(dbUser.name || ""),
                first_name: String(dbUser.first_name || ""),
                last_name: String(dbUser.last_name || ""),
                preferred_email: String(dbUser.preferred_email || dbUser.email || ""),
            };
        }
    }

    if (existingApplication && !existingApplication.is_draft) {
        return Astro.redirect("/dashboard");
    }

    if (!applicationsOpen && !existingApplication) {
        return Astro.redirect("/applications-closed");
    }

    if (existingApplication && existingApplication.is_draft) {
        try {
            draftData = JSON.parse(existingApplication.experience_data || "{}");
        } catch (e) {
            draftData = {};
        }
    }
}

if (!session) {
    return Astro.redirect("/");
}

const currentLoc = existingApplication?.student_location || draftData?.student_location || "";
const currentLocDetail = draftData?.location_detail || "";
// Legacy drafts used step 4 for Review; Review is now step 5 (Python optional is 4)
const rawInitialStep = draftData?.current_step || 1;
const initialStep = rawInitialStep === 4 ? 5 : rawInitialStep;
const initialSectionStatuses = calculateDraftSectionStatuses(currentUser, existingApplication);

const usStates = [
  "Alabama", "Alaska", "Arizona", "Arkansas", "California", "Colorado", "Connecticut", "Delaware", 
  "Florida", "Georgia", "Hawaii", "Idaho", "Illinois", "Indiana", "Iowa", "Kansas", "Kentucky", 
  "Louisiana", "Maine", "Maryland", "Michigan", "Minnesota", "Mississippi", "Missouri", 
  "Montana", "Nebraska", "Nevada", "New Hampshire", "New Jersey", "New Mexico", "New York", 
  "North Carolina", "North Dakota", "Ohio", "Oklahoma", "Oregon", "Pennsylvania", "Rhode Island", 
  "South Carolina", "South Dakota", "Tennessee", "Texas", "Utah", "Vermont", "Virginia", 
  "Washington", "West Virginia", "Wisconsin", "Wyoming", "District of Columbia", "Puerto Rico", "Other"
];

const countries = [
  "Canada", "United Kingdom", "China", "India", "Germany", "France", "Japan", "South Korea", 
  "Australia", "Brazil", "Mexico", "Singapore", "Taiwan", "Vietnam", "Nigeria", "Egypt", 
  "Turkey", "Spain", "Italy", "Switzerland", "Netherlands", "Sweden", "Other"
];

const mlFrameworks = [
  "PyTorch", "TensorFlow/Keras", "Scikit-Learn", "Pandas/NumPy", 
  "XGBoost / Trees / GBM", "OpenCV", "Hugging Face / LLMs", "Other", "None"
];
---

<Layout title={isTestMode ? "Test Application Form" : "Application Form - Application Portal"} session={session} userRole={userRole} isTestMode={isTestMode}>
    <div class="container" style="max-width: 1140px;">
        
        {isTestMode && (
            <div class="notice-box" style="margin-bottom: 1.5rem; background: #FFFBEB; border-color: #F59E0B; color: #92400E;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <div>
                    <div class="notice-title">Local test mode</div>
                    <p class="notice-body">
                        No Google sign-in required. Drafts, submissions, and assessments are simulated in the browser and are not written to the database.
                    </p>
                </div>
            </div>
        )}

        <div style="margin-bottom: 2rem;">
            <h2 style="font-size: 2rem; font-weight: 800; color: var(--slate-900); margin-bottom: 0.25rem;">
                Bootcamp Application Form
            </h2>
            <p style="color: var(--slate-600); font-size: 1rem;">
                Complete all required sections below. You can save each section independently and return at any time.
            </p>
        </div>

        <!-- Two Column Layout: Sticky Progress Sidebar + Wizard Forms -->
        <div style="display: grid; grid-template-columns: 280px 1fr; gap: 2rem; align-items: start;">
            
            <!-- SIDEBAR PROGRESS TIMELINE -->
            <aside class="card-clean" style="position: sticky; top: 90px; padding: 1.5rem; margin-bottom: 0;">
                <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--slate-500); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.25rem;">
                    Application Progress
                </h4>

                <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                    {[
                        { num: 1, label: '1. Personal & Parent Info', desc: 'Contact details & location' },
                        { num: 2, label: '2. Background & Skills', desc: 'Experience, languages & ML' },
                        { num: 3, label: '3. Essays', desc: 'Two required essays' },
                        { num: 4, label: '4. Python (Optional)', desc: 'Practice Colab & short exercise' },
                        { num: 5, label: '5. Review & Submit', desc: 'Final application check' }
                    ].map((step) => (
                        <button
                            type="button"
                            class="sidebar-step-btn"
                            data-step={step.num}
                            style="display: flex; align-items: flex-start; gap: 0.85rem; text-align: left; background: none; border: none; padding: 0.5rem; border-radius: var(--radius-sm); cursor: pointer; transition: background 0.15s ease; width: 100%;"
                        >
                            <div class={`step-num-bubble step-num-${step.num}`} style="width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px;">
                            </div>
                            <div>
                                <div class={`step-title-text step-title-${step.num}`} style="font-size: 0.875rem; font-weight: 600; color: var(--slate-700);">
                                    {step.label}
                                </div>
                                <div class={`step-status-subtext step-sub-${step.num}`} style="font-size: 0.775rem; color: var(--slate-500);">
                                    {step.desc}
                                </div>
                            </div>
                        </button>
                    ))}
                </div>

                <!-- Legend -->
                <div style="margin-top: 1.5rem; border-top: 1px solid var(--slate-200); padding-top: 1rem; font-size: 0.75rem; color: var(--slate-600);">
                    <div style="font-weight: 700; margin-bottom: 0.4rem; color: var(--slate-700);">Draft Status Legend:</div>
                    <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem;">
                        <span style="width: 10px; height: 10px; border-radius: 50%; background: #16A34A; display: inline-block;"></span>
                        Green: Complete
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem;">
                        <span style="width: 10px; height: 10px; border-radius: 50%; background: #D97706; display: inline-block;"></span>
                        Yellow: Incomplete / In Progress
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.4rem;">
                        <span style="width: 10px; height: 10px; border-radius: 50%; background: #334155; display: inline-block;"></span>
                        Dark: Not Started
                    </div>
                </div>

                <div style="margin-top: 1.25rem;">
                    <button type="button" id="save-current-section-btn" class="btn btn-secondary btn-sm" style="width: 100%;">
                        Save Current Section
                    </button>
                    <div id="section-save-status" style="font-size: 0.75rem; text-align: center; margin-top: 0.5rem;" aria-live="polite"></div>
                </div>
            </aside>

            <!-- MAIN WIZARD FORM CONTAINER -->
            <main>
                <!-- Logistics Notices -->
                <div class="notice-box notice-info" style="margin-bottom: 1.5rem;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <div>
                        <div class="notice-title">Program Logistics Notice</div>
                        <p class="notice-body">
                            Please note: This summer bootcamp program is <strong>non-residential</strong>. Admitted students will commute daily to the MIT program location.
                        </p>
                    </div>
                </div>

                <form method="POST" action={isTestMode ? "#" : "/api/submit-application"} id="application-form">
                    <input type="hidden" name="current_step" id="current_step_input" value={initialStep} />
                    <input type="hidden" name="device_fp" id="applicant_device_fp_input" value="" />
                    {isTestMode && <input type="hidden" id="is_test_mode" value="1" />}

                    <!-- SECTION 1: PERSONAL, PARENT & RECOMMENDER INFORMATION -->
                    <div id="form-section-1" class="wizard-section" style="display: none;">
                        <div class="card-clean">
                            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--slate-900); margin-bottom: 1.25rem; border-bottom: 1px solid var(--slate-200); padding-bottom: 0.6rem;">
                                1. Personal & Location Details
                            </h3>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
                                <div class="form-group">
                                    <label class="form-label" for="first_name">First Name *</label>
                                    <input
                                        type="text"
                                        id="first_name"
                                        name="first_name"
                                        class="input-field"
                                        required
                                        maxlength="50"
                                        value={currentUser.first_name || ""}
                                        placeholder="First name"
                                    />
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="last_name">Last Name *</label>
                                    <input
                                        type="text"
                                        id="last_name"
                                        name="last_name"
                                        class="input-field"
                                        required
                                        maxlength="50"
                                        value={currentUser.last_name || ""}
                                        placeholder="Last name"
                                    />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="preferred_email">Preferred Contact Email *</label>
                                <input
                                    type="email"
                                    id="preferred_email"
                                    name="preferred_email"
                                    class="input-field"
                                    required
                                    maxlength="100"
                                    value={currentUser.preferred_email || currentUser.email || ""}
                                    placeholder="email@example.com"
                                />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="student_location">Student Location *</label>
                                <select id="student_location" name="student_location" class="select-field" required>
                                    <option value="">Select location</option>
                                    <option value="massachusetts" selected={currentLoc === "massachusetts"}>Massachusetts</option>
                                    <option value="out_of_state" selected={currentLoc === "out_of_state"}>Out of State (US)</option>
                                    <option value="international" selected={currentLoc === "international"}>International</option>
                                </select>
                            </div>

                            <!-- Dynamic State / Country Select Dropdown -->
                            <div class="form-group" id="location-detail-group" style={currentLoc === 'out_of_state' || currentLoc === 'international' ? '' : 'display: none;'}>
                                <label class="form-label" for="location_detail" id="location-detail-label">
                                    {currentLoc === 'international' ? 'Select Country *' : 'Select State *'}
                                </label>
                                <select id="location_detail" name="location_detail" class="select-field">
                                    <option value="">Select option</option>
                                </select>
                            </div>
                        </div>

                        <!-- Parent / Guardian Information -->
                        <div class="card-clean">
                            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--slate-900); margin-bottom: 1.25rem; border-bottom: 1px solid var(--slate-200); padding-bottom: 0.6rem;">
                                Parent / Guardian Contact Details
                            </h3>

                            <div class="form-group">
                                <label class="form-label" for="parent_name">Parent / Guardian Full Name *</label>
                                <input
                                    type="text"
                                    id="parent_name"
                                    name="parent_name"
                                    class="input-field"
                                    required
                                    maxlength="100"
                                    value={draftData?.parent_name || ""}
                                    placeholder="e.g. Jane Doe"
                                />
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="form-label" for="parent_email">Parent / Guardian Email *</label>
                                    <input
                                        type="email"
                                        id="parent_email"
                                        name="parent_email"
                                        class="input-field"
                                        required
                                        maxlength="100"
                                        value={draftData?.parent_email || ""}
                                        placeholder="parent@example.com"
                                    />
                                </div>

                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="form-label" for="parent_phone">Parent / Guardian Phone Number *</label>
                                    <input
                                        type="tel"
                                        id="parent_phone"
                                        name="parent_phone"
                                        class="input-field"
                                        required
                                        maxlength="25"
                                        value={draftData?.parent_phone || ""}
                                        placeholder="(555) 123-4567"
                                    />
                                </div>
                            </div>
                        </div>

                        <!-- Recommender Information -->
                        <div class="card-clean">
                            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--slate-900); margin-bottom: 1.25rem; border-bottom: 1px solid var(--slate-200); padding-bottom: 0.6rem;">
                                Recommendation Letter Contact
                            </h3>

                            <div class="notice-box notice-info" style="margin-bottom: 0.85rem; background: #EFF6FF; border-color: #BFDBFE;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <div>
                                    <div class="notice-title" style="color: #1E40AF;">Automated Recommendation Request Notice</div>
                                    <p class="notice-body" style="color: #1E3A8A; line-height: 1.5;">
                                        <strong>Automated Email Dispatch:</strong> Upon application submission, an automated recommendation request will be emailed directly to your recommender from <strong style="text-decoration: underline;">mitjclinic.camp.rec.letters@gmail.com</strong> (Automated No-Reply Email System).
                                        <br/>
                                        <em>Please inform your recommender to check their <strong>Junk / Spam / Promotions</strong> folder if they do not see it in their main inbox.</em>
                                    </p>
                                </div>
                            </div>

                            <div class="notice-box notice-warning" style="margin-bottom: 1.25rem; background: #FFFBEB; border-color: #FCD34D;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="12" y1="18" x2="12" y2="12"></line>
                                    <line x1="12" y1="9" x2="12.01" y2="9"></line>
                                </svg>
                                <div>
                                    <div class="notice-title" style="color: #92400E;">Alternative Submission via PDF Email</div>
                                    <p class="notice-body" style="color: #78350F; line-height: 1.5;">
                                        If no email is received by your recommender, they can send a <strong>PDF copy of their recommendation letter directly to <a href="mailto:jclinic-info@mit.edu" style="color: #92400E; font-weight: 700; text-decoration: underline;">jclinic-info@mit.edu</a></strong> with your full name in the email subject line.
                                    </p>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
                                <div class="form-group">
                                    <label class="form-label" for="recommender_name">Recommender Full Name *</label>
                                    <input
                                        type="text"
                                        id="recommender_name"
                                        name="recommender_name"
                                        class="input-field"
                                        required
                                        maxlength="100"
                                        value={draftData?.recommender_name || ""}
                                        placeholder="e.g. Dr. Sarah Jenkins"
                                    />
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="recommender_email">Recommender Email Address *</label>
                                    <input
                                        type="email"
                                        id="recommender_email"
                                        name="recommender_email"
                                        class="input-field"
                                        required
                                        maxlength="100"
                                        value={draftData?.recommender_email || ""}
                                        placeholder="teacher@school.edu"
                                    />
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 1.25rem;">
                                <label class="form-label" for="recommender_title">Recommender Title / School</label>
                                <input
                                    type="text"
                                    id="recommender_title"
                                    name="recommender_title"
                                    class="input-field"
                                    maxlength="150"
                                    value={draftData?.recommender_title || ""}
                                    placeholder="e.g. AP Computer Science Teacher, Newton High"
                                />
                            </div>

                            <div style="background: var(--slate-50); border: 1px solid var(--slate-200); padding: 0.85rem 1rem; border-radius: var(--radius-sm);">
                                <label style="display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; font-size: 0.825rem; color: var(--slate-800); font-weight: 500;">
                                    <input type="checkbox" required checked style="accent-color: var(--brand-blue); margin-top: 2px;" />
                                    I hereby waive my right to inspect or access this recommendation letter under FERPA guidelines, certifying that it will be submitted confidentially by my recommender.
                                </label>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
                            <button type="button" class="btn btn-secondary save-section-btn">
                                Save Section Draft
                            </button>
                            <button type="button" class="btn btn-primary goto-step-btn" data-target="2">
                                Next: Background & Skills →
                            </button>
                        </div>
                    </div>

                    <!-- SECTION 2: BACKGROUND & TECHNICAL SKILLS -->
                    <div id="form-section-2" class="wizard-section" style="display: none;">
                        <div class="card-clean">
                            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--slate-900); margin-bottom: 1.25rem; border-bottom: 1px solid var(--slate-200); padding-bottom: 0.6rem;">
                                2. Background & Technical Experience
                            </h3>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
                                <div class="form-group">
                                    <label class="form-label" for="grade_level">Grade Level (Fall 2027) *</label>
                                    <select id="grade_level" name="grade_level" class="select-field" required>
                                        <option value="">Select grade</option>
                                        <option value="9th" selected={draftData?.grade_level === "9th"}>9th Grade (Freshman)</option>
                                        <option value="10th" selected={draftData?.grade_level === "10th"}>10th Grade (Sophomore)</option>
                                        <option value="11th" selected={draftData?.grade_level === "11th"}>11th Grade (Junior)</option>
                                        <option value="12th" selected={draftData?.grade_level === "12th"}>12th Grade (Senior)</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="programming_experience">Programming Experience *</label>
                                    <select id="programming_experience" name="programming_experience" class="select-field" required>
                                        <option value="">Select experience level</option>
                                        <option value="none" selected={draftData?.programming_experience === "none"}>No programming experience</option>
                                        <option value="beginner" selected={draftData?.programming_experience === "beginner"}>Beginner (Some Python/JS)</option>
                                        <option value="intermediate" selected={draftData?.programming_experience === "intermediate"}>Intermediate (Built small projects)</option>
                                        <option value="advanced" selected={draftData?.programming_experience === "advanced"}>Advanced (Data structures & algorithm experience)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Programming Languages Checkboxes -->
                            <div class="form-group">
                                <label class="form-label">Programming Languages Used * (Select all that apply or None)</label>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-top: 0.4rem;">
                                    {["Python", "Java", "JS/TS", "C++", "Rust", "Other", "None"].map((lang) => (
                                        <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.85rem; background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-sm); cursor: pointer; font-size: 0.85rem; font-weight: 500; white-space: nowrap;">
                                            <input
                                                type="checkbox"
                                                name="languages"
                                                class="lang-checkbox"
                                                value={lang}
                                                checked={draftData?.languages?.includes(lang)}
                                                style="accent-color: var(--brand-blue);"
                                            />
                                            {lang}
                                        </label>
                                    ))}
                                </div>
                            </div>

                            <!-- Machine Learning Technologies Checkboxes -->
                            <div class="form-group">
                                <label class="form-label">Machine Learning Technologies & Frameworks Used * (Select all that apply or None)</label>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 0.75rem; margin-top: 0.4rem;">
                                    {mlFrameworks.map((ml) => (
                                        <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.65rem 0.85rem; background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-sm); cursor: pointer; font-size: 0.825rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <input
                                                type="checkbox"
                                                name="ml_technologies"
                                                class="ml-checkbox"
                                                value={ml}
                                                checked={draftData?.ml_technologies?.includes(ml)}
                                                style="accent-color: var(--brand-blue); flex-shrink: 0;"
                                            />
                                            <span style="overflow: hidden; text-overflow: ellipsis;">{ml}</span>
                                        </label>
                                    ))}
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Research Experience *</label>
                                <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.4rem;">
                                    {[
                                        { val: "yes", label: "Yes, I have conducted independent or lab research" },
                                        { val: "coursework", label: "Only through high school coursework / class projects" },
                                        { val: "no", label: "No prior research experience, but eager to learn" }
                                    ].map((item) => (
