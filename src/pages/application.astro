                                {applicationsOpen ? "Submit Final Application" : "Submissions Closed"}
                            </button>
                        </div>

                        <div style="display: flex; justify-content: flex-start;">
                            <button type="button" class="btn btn-secondary goto-step-btn" data-target="3">
                                ← Back to Essays
                            </button>
                        </div>
                    </div>

                </form>
            </main>

        </div>

    </div>

    <!-- Data arrays for client side -->
    <script is:inline define:vars={{ usStates, countries, currentLocDetail, initialStep, initialSectionStatuses }}>
        window.US_STATES = usStates;
        window.COUNTRIES = countries;
        window.INITIAL_LOC_DETAIL = currentLocDetail;
        window.INITIAL_STEP = initialStep;
        window.INITIAL_SECTION_STATUSES = initialSectionStatuses;
    </script>

    <!-- Client-side Script -->
    <script is:inline>
        function getDeviceFingerprint() {
            const nav = window.navigator;
            const screen = window.screen;
            const raw = [
                nav.userAgent,
                nav.language,
                screen.colorDepth,
                screen.width + 'x' + screen.height,
                new Date().getTimezoneOffset(),
                nav.hardwareConcurrency || 'unk'
            ].join('||');
            
            let hash = 0;
            for (let i = 0; i < raw.length; i++) {
                const char = raw.charCodeAt(i);
                hash = ((hash << 5) - hash) + char;
                hash |= 0;
            }
            return 'fp_' + Math.abs(hash).toString(36);
        }

        let currentStep = window.INITIAL_STEP || 1;
        let sectionStatuses = window.INITIAL_SECTION_STATUSES || { sec1: 'not_started', sec2: 'not_started', sec3: 'not_started' };

        function evaluateClientSectionStatuses() {
            // Sec 1
            const fName = document.getElementById('first_name')?.value?.trim();
            const lName = document.getElementById('last_name')?.value?.trim();
            const pEmail = document.getElementById('preferred_email')?.value?.trim();
            const pName = document.getElementById('parent_name')?.value?.trim();
            const parEmail = document.getElementById('parent_email')?.value?.trim();
            const pPhone = document.getElementById('parent_phone')?.value?.trim();
            const recName = document.getElementById('recommender_name')?.value?.trim();
            const recEmail = document.getElementById('recommender_email')?.value?.trim();
            const loc = document.getElementById('student_location')?.value;

            const sec1Filled = [fName, lName, pEmail, pName, parEmail, pPhone, recName, recEmail, loc].filter(Boolean).length;
            if (sec1Filled === 9) sectionStatuses.sec1 = 'complete';
            else if (sec1Filled > 0) sectionStatuses.sec1 = 'incomplete';
            else sectionStatuses.sec1 = 'not_started';

            // Sec 2
            const grade = document.getElementById('grade_level')?.value;
            const prog = document.getElementById('programming_experience')?.value;
            const langs = Array.from(document.querySelectorAll('.lang-checkbox:checked'));
            const mls = Array.from(document.querySelectorAll('.ml-checkbox:checked'));
            const res = document.querySelector('input[name="research_experience"]:checked');
            const aid = document.querySelector('input[name="needs_financial_aid"]:checked');
            const clubs = document.getElementById('clubs_activities')?.value?.trim();
            const thoughts = document.getElementById('final_thoughts')?.value?.trim();

            const sec2Filled = [grade, prog, langs.length > 0, mls.length > 0, res, aid, clubs, thoughts].filter(Boolean).length;
            if (sec2Filled === 8) sectionStatuses.sec2 = 'complete';
            else if (sec2Filled > 0) sectionStatuses.sec2 = 'incomplete';
            else sectionStatuses.sec2 = 'not_started';

            // Sec 3: BOTH essays MUST have text to be complete
            const e1 = document.getElementById('essay_one')?.value?.trim() || '';
            const e2 = document.getElementById('essay_two')?.value?.trim() || '';

            if (e1.length > 0 && e2.length > 0) {
                sectionStatuses.sec3 = 'complete';
            } else if (e1.length > 0 || e2.length > 0) {
                sectionStatuses.sec3 = 'incomplete';
            } else {
                sectionStatuses.sec3 = 'not_started';
            }

            updateSidebarBubbles();
            populateReviewSummary();
        }

        function updateSidebarBubbles() {
            const statusMap = {
                1: sectionStatuses.sec1,
                2: sectionStatuses.sec2,
                3: sectionStatuses.sec3,
                4: (sectionStatuses.sec1 === 'complete' && sectionStatuses.sec2 === 'complete' && sectionStatuses.sec3 === 'complete') ? 'complete' : 'incomplete'
            };

            document.querySelectorAll('.sidebar-step-btn').forEach(btn => {
                const s = parseInt(btn.getAttribute('data-step'));
                const bubble = btn.querySelector('.step-num-bubble');
                const title = btn.querySelector('.step-title-text');
                const status = statusMap[s] || 'not_started';

                if (bubble) {
                    if (status === 'complete') {
                        bubble.style.background = '#16A34A';
                        bubble.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
                    } else if (status === 'incomplete') {
                        bubble.style.background = '#D97706';
                        bubble.innerHTML = '<div style="width: 8px; height: 8px; border-radius: 50%; background: #FFFFFF;"></div>';
                    } else {
                        bubble.style.background = '#334155';
                        bubble.innerHTML = '<div style="width: 6px; height: 6px; border-radius: 50%; background: #94A3B8;"></div>';
                    }
                }

                const subText = btn.querySelector('.step-status-subtext');
                if (subText) {
                    subText.textContent = status === 'complete' ? 'Complete' : status === 'incomplete' ? 'In Progress' : 'Not Started';
                }

                if (s === currentStep) {
                    btn.style.background = 'var(--brand-blue-light)';
                    if (title) title.style.color = 'var(--brand-blue)';
                } else {
                    btn.style.background = 'none';
                    if (title) title.style.color = 'var(--slate-800)';
                }
            });
        }

        function populateReviewSummary() {
            const fName = document.getElementById('first_name')?.value?.trim() || '';
            const lName = document.getElementById('last_name')?.value?.trim() || '';
            document.getElementById('rev-student-name').textContent = `${fName} ${lName}`.trim() || 'Not provided';
            document.getElementById('rev-contact-email').textContent = document.getElementById('preferred_email')?.value?.trim() || 'Not provided';

            const loc = document.getElementById('student_location')?.value;
            const locDetail = document.getElementById('location_detail')?.value;
            let displayLoc = 'Massachusetts';
            if (loc === 'out_of_state') displayLoc = locDetail ? `Out of State (${locDetail})` : 'Out of State (US)';
            else if (loc === 'international') displayLoc = locDetail ? `International (${locDetail})` : 'International';
            document.getElementById('rev-location').textContent = loc ? displayLoc : 'Not provided';

            document.getElementById('rev-parent-name').textContent = document.getElementById('parent_name')?.value?.trim() || 'Not provided';
            document.getElementById('rev-parent-email').textContent = document.getElementById('parent_email')?.value?.trim() || 'Not provided';
            document.getElementById('rev-parent-phone').textContent = document.getElementById('parent_phone')?.value?.trim() || 'Not provided';

            document.getElementById('rev-rec-name').textContent = document.getElementById('recommender_name')?.value?.trim() || 'Not provided';
            document.getElementById('rev-rec-email').textContent = document.getElementById('recommender_email')?.value?.trim() || 'Not provided';

            document.getElementById('rev-grade').textContent = document.getElementById('grade_level')?.value || 'Not provided';
            document.getElementById('rev-prog-exp').textContent = document.getElementById('programming_experience')?.value || 'Not provided';

            const aid = document.querySelector('input[name="needs_financial_aid"]:checked')?.value;
            document.getElementById('rev-aid').textContent = aid ? (aid === 'yes' ? 'Yes' : 'No') : 'Not selected';

            const res = document.querySelector('input[name="research_experience"]:checked')?.value;
            document.getElementById('rev-research').textContent = res || 'Not selected';

            const langs = Array.from(document.querySelectorAll('.lang-checkbox:checked')).map(c => c.value);
            document.getElementById('rev-languages').textContent = langs.length ? langs.join(', ') : 'None selected';

            const mls = Array.from(document.querySelectorAll('.ml-checkbox:checked')).map(c => c.value);
            document.getElementById('rev-ml').textContent = mls.length ? mls.join(', ') : 'None selected';

            const e1 = document.getElementById('essay_one')?.value?.trim() || '';
            const e2 = document.getElementById('essay_two')?.value?.trim() || '';
            const w1 = e1 ? e1.split(/\s+/).length : 0;
            const w2 = e2 ? e2.split(/\s+/).length : 0;

            document.getElementById('rev-essay1-status').textContent = e1 ? `Provided (${w1} words)` : 'Empty';
            document.getElementById('rev-essay1-preview').textContent = e1 ? `"${e1.slice(0, 150)}..."` : 'No text entered.';

            document.getElementById('rev-essay2-status').textContent = e2 ? `Provided (${w2} words)` : 'Empty';
            document.getElementById('rev-essay2-preview').textContent = e2 ? `"${e2.slice(0, 150)}..."` : 'No text entered.';
        }

        function showStep(stepNum) {
            currentStep = stepNum;
            document.getElementById('current_step_input').value = stepNum;

            // Hide all section divs
            document.querySelectorAll('.wizard-section').forEach(sec => {
                sec.style.display = 'none';
            });
            // Show target section
            const targetSec = document.getElementById(`form-section-${stepNum}`);
            if (targetSec) targetSec.style.display = 'block';

            evaluateClientSectionStatuses();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Handle Sidebar & Next/Prev navigation with Native Auto-Save
        document.querySelectorAll('.sidebar-step-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const s = parseInt(this.getAttribute('data-step'));
                saveSectionDraft();
                showStep(s);
            });
        });

        document.querySelectorAll('.goto-step-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const target = parseInt(this.getAttribute('data-target'));
                saveSectionDraft();
                showStep(target);
            });
        });

        // Mutual Exclusion for Checkboxes ("None" handling)
        function handleExclusiveCheckboxes(checkboxClass) {
            const boxes = document.querySelectorAll(`.${checkboxClass}`);
            boxes.forEach(box => {
                box.addEventListener('change', function() {
                    if (this.value === 'None' && this.checked) {
                        boxes.forEach(b => {
                            if (b.value !== 'None') b.checked = false;
                        });
                    } else if (this.value !== 'None' && this.checked) {
                        boxes.forEach(b => {
                            if (b.value === 'None') b.checked = false;
                        });
                    }
                    evaluateClientSectionStatuses();
                });
            });
        }

        // Real-time Word Counter
        function countWords(str) {
            const trimmed = str.trim();
            return trimmed ? trimmed.split(/\s+/).length : 0;
        }

        function updateCounters(textareaId, charId, badgeId) {
            const text = document.getElementById(textareaId).value;
            const charCount = text.length;
            const wordCount = countWords(text);

            document.getElementById(charId).textContent = charCount;

            const badge = document.getElementById(badgeId);
            if (wordCount >= 500 && wordCount <= 750) {
                badge.className = "badge-pill pill-success";
                badge.innerHTML = `Words: <strong>${wordCount}</strong> (Target 500–750 met)`;
            } else if (wordCount > 0) {
                badge.className = "badge-pill pill-warning";
                badge.innerHTML = `Words: <strong>${wordCount}</strong> (Target: 500–750 words)`;
            } else {
                badge.className = "badge-pill pill-neutral";
                badge.innerHTML = `Words: <strong>0</strong> (Target: 500–750 words)`;
            }
            evaluateClientSectionStatuses();
        }

        // Dynamic Location Detail Dropdown
        const locationSelect = document.getElementById('student_location');
        const locationDetailGroup = document.getElementById('location-detail-group');
        const locationDetailLabel = document.getElementById('location-detail-label');
        const locationDetailSelect = document.getElementById('location_detail');

        function updateLocationDetail() {
            const val = locationSelect.value;
            const initialVal = window.INITIAL_LOC_DETAIL || '';

            if (val === 'out_of_state') {
                locationDetailGroup.style.display = 'block';
                locationDetailLabel.textContent = 'Select State *';
                locationDetailSelect.required = true;
                populateOptions(window.US_STATES, initialVal);
            } else if (val === 'international') {
                locationDetailGroup.style.display = 'block';
                locationDetailLabel.textContent = 'Select Country *';
                locationDetailSelect.required = true;
                populateOptions(window.COUNTRIES, initialVal);
            } else {
                locationDetailGroup.style.display = 'none';
                locationDetailSelect.required = false;
                locationDetailSelect.innerHTML = '<option value="">Select option</option>';
            }
            evaluateClientSectionStatuses();
        }

        function populateOptions(list, selectedValue) {
            let html = '<option value="">Select option</option>';
            list.forEach(item => {
                const isSel = (item.toLowerCase() === selectedValue.toLowerCase()) ? 'selected' : '';
                html += `<option value="${item}" ${isSel}>${item}</option>`;
            });
            locationDetailSelect.innerHTML = html;
        }

        locationSelect?.addEventListener('change', updateLocationDetail);

        // Section Draft Save AJAX
        async function saveSectionDraft() {
            const statusDiv = document.getElementById('section-save-status');
            statusDiv.style.color = 'var(--slate-600)';
            statusDiv.textContent = 'Saving draft...';

            try {
                const form = document.getElementById('application-form');
                const formData = new FormData(form);

                const res = await fetch('/api/save-draft', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (res.ok) {
                    statusDiv.style.color = 'var(--success-green)';
                    statusDiv.textContent = '✓ Section Draft Saved';
                    evaluateClientSectionStatuses();
                    setTimeout(() => { statusDiv.textContent = ''; }, 3000);
                } else {
                    throw new Error(data.error || 'Failed to save');
                }
            } catch (err) {
                statusDiv.style.color = '#DC2626';
                statusDiv.textContent = 'Error saving draft';
            }
        }

        document.getElementById('save-current-section-btn')?.addEventListener('click', saveSectionDraft);
        document.querySelectorAll('.save-section-btn').forEach(btn => {
            btn.addEventListener('click', saveSectionDraft);
        });

        // Add real-time input listeners to all form fields
        document.querySelectorAll('input, select, textarea').forEach(input => {
            input.addEventListener('change', evaluateClientSectionStatuses);
            input.addEventListener('input', evaluateClientSectionStatuses);
        });

        document.addEventListener('DOMContentLoaded', () => {
            const fpInput = document.getElementById('applicant_device_fp_input');
            if (fpInput) fpInput.value = getDeviceFingerprint();

            showStep(currentStep);
            updateLocationDetail();
            handleExclusiveCheckboxes('lang-checkbox');
            handleExclusiveCheckboxes('ml-checkbox');

            ['essay_one', 'essay_two'].forEach((id, idx) => {
                const charId = idx === 0 ? 'essay-one-chars' : 'essay-two-chars';
                const wordId = idx === 0 ? 'essay-one-words' : 'essay-two-words';
                const badgeId = idx === 0 ? 'essay-one-words-badge' : 'essay-two-words-badge';
                
                const el = document.getElementById(id);
                if (el) {
                    updateCounters(id, charId, wordId, badgeId);
                    el.addEventListener('input', () => updateCounters(id, charId, wordId, badgeId));
                }
            });

            evaluateClientSectionStatuses();
        });
    </script>
</Layout>
