                                        What are your future goals and how do you think this summer program will help you explore potential career paths? (Target: 500–750 words)
                                    </span>
                                </label>
                                <textarea
                                    id="essay_two"
                                    name="essay_two"
                                    class="textarea-field"
                                    rows="8"
                                    required
                                    maxlength="5000"
                                    placeholder="Write your response here..."
                                >{existingApplication ? existingApplication.essay_two || "" : ""}</textarea>
                                
                                <div class="counter-bar" aria-live="polite">
                                    <span>Characters: <strong id="essay-two-chars">0</strong>/5000</span>
                                    <span id="essay-two-words-badge" class="badge-pill pill-neutral">
                                        Words: <strong id="essay-two-words">0</strong> (Target: 500–750)
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
                            <button type="button" class="btn btn-secondary goto-step-btn" data-target="2">
                                ← Back: Background & Skills
                            </button>
                            <div style="display: flex; gap: 0.75rem;">
                                <button type="button" class="btn btn-secondary save-section-btn">
                                    Save Section Draft
                                </button>
                                <button type="button" class="btn btn-primary goto-step-btn" data-target="4">
                                    Next: Review Application →
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: REVIEW & FINAL SUBMIT (Full Information Summary) -->
                    <div id="form-section-4" class="wizard-section" style="display: none;">
                        <div class="card-clean">
                            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--slate-900); margin-bottom: 1.25rem; border-bottom: 1px solid var(--slate-200); padding-bottom: 0.6rem;">
                                4. Review & Submit Application
                            </h3>

                            <p style="color: var(--slate-600); font-size: 0.925rem; margin-bottom: 1.5rem;">
                                Please review the summary of your provided information below before submitting.
                            </p>

                            <!-- Live Application Summary Preview -->
                            <div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.75rem;">
                                
                                <!-- Personal, Parent & Recommender Summary Card -->
                                <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-sm); padding: 1.25rem;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 1px solid var(--slate-200); padding-bottom: 0.5rem;">
                                        <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--brand-blue); margin: 0;">1. Personal, Parent & Recommender Details</h4>
                                        <button type="button" class="btn btn-secondary btn-sm goto-step-btn" data-target="1" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">Edit Section 1</button>
                                    </div>
                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; font-size: 0.875rem;">
                                        <div><strong>Student Name:</strong> <span id="rev-student-name">-</span></div>
                                        <div><strong>Contact Email:</strong> <span id="rev-contact-email">-</span></div>
                                        <div><strong>Location:</strong> <span id="rev-location">-</span></div>
                                        <div><strong>Parent Name:</strong> <span id="rev-parent-name">-</span></div>
                                        <div><strong>Parent Email:</strong> <span id="rev-parent-email">-</span></div>
                                        <div><strong>Parent Phone:</strong> <span id="rev-parent-phone">-</span></div>
                                        <div><strong>Recommender Name:</strong> <span id="rev-rec-name">-</span></div>
                                        <div><strong>Recommender Email:</strong> <span id="rev-rec-email">-</span></div>
                                    </div>
