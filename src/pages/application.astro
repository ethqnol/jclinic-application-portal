                    <!-- SECTION 3: ESSAY RESPONSES -->
                    <div id="form-section-3" class="wizard-section" style="display: none;">
                        <div class="card-clean">
                            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--slate-900); margin-bottom: 1.25rem; border-bottom: 1px solid var(--slate-200); padding-bottom: 0.6rem;">
