                                        <button type="button" class="btn btn-secondary btn-sm goto-step-btn" data-target="4" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;">Edit Section 4</button>
                                    </div>
                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; font-size: 0.875rem; margin-bottom: 0.75rem;">
                                        <div id="rev-python-exp-row"><strong>Python Experience:</strong> <span id="rev-python-exp">-</span></div>
                                        <div id="rev-python-status-row"><strong>Timed Questions:</strong> <span id="rev-python-status">-</span></div>
                                        <div id="rev-colab-row" style="grid-column: 1 / -1;">
                                            <strong>Colab Link:</strong>
                                            <a id="rev-colab-link" href="#" target="_blank" rel="noopener noreferrer" style="color: var(--brand-blue); word-break: break-all; margin-left: 0.25rem;"></a>
                                            <span id="rev-colab-none" style="color: var(--slate-600);"></span>
                                        </div>
                                    </div>
                                    <div id="rev-python-answers" style="display: none; flex-direction: column; gap: 0.75rem; font-size: 0.875rem; margin-top: 0.25rem;"></div>
                                </div>

                            </div>

                            <button
                                type="submit"
                                class="btn btn-primary"
                                style="width: 100%; padding: 0.85rem;"
                                disabled={!applicationsOpen}
                            >
                                {applicationsOpen ? "Submit Final Application" : "Submissions Closed"}
                            </button>
                            <div id="test-submit-status" style="font-size: 0.875rem; text-align: center; margin-top: 0.75rem;" aria-live="polite"></div>
                        </div>

                        <div style="display: flex; justify-content: flex-start;">
                            <button type="button" class="btn btn-secondary goto-step-btn" data-target="4">
                                ← Back to Python (Optional)
                            </button>
                        </div>
                    </div>

                </form>
            </main>

        </div>

    </div>

    <!-- Data arrays for client side -->
    <script is:inline define:vars={{ usStates, countries, currentLocDetail, initialStep, initialSectionStatuses, draftData, isTestMode }}>
        window.US_STATES = usStates;
        window.COUNTRIES = countries;
        window.INITIAL_LOC_DETAIL = currentLocDetail;
        window.INITIAL_STEP = initialStep;
        window.INITIAL_SECTION_STATUSES = initialSectionStatuses;
        window.DRAFT_PYTHON_ASSESSMENT = (draftData && draftData.python_assessment) ? draftData.python_assessment : null;
        window.DRAFT_PYTHON_EXPERIENCE = (draftData && draftData.python_experience) ? draftData.python_experience : null;
        window.IS_TEST_MODE = Boolean(isTestMode);
    </script>

    <!-- Client-side Script -->
    <script is:inline>
        function getDeviceFingerprint() {
            const nav = window.navigator;
            const screen = window.screen;
            const raw = [
                nav.userAgent,
                nav.language,
                screen.colorDepth,
                screen.width + 'x' + screen.height,
                new Date().getTimezoneOffset(),
                nav.hardwareConcurrency || 'unk'
            ].join('||');
            
            let hash = 0;
            for (let i = 0; i < raw.length; i++) {
                const char = raw.charCodeAt(i);
                hash = ((hash << 5) - hash) + char;
                hash |= 0;
            }
            return 'fp_' + Math.abs(hash).toString(36);
        }

        let currentStep = window.INITIAL_STEP || 1;
        let sectionStatuses = window.INITIAL_SECTION_STATUSES || { sec1: 'not_started', sec2: 'not_started', sec3: 'not_started', sec4: 'not_started' };
        let testPythonAssessment = null;

        function evaluateClientSectionStatuses() {
            // Sec 1
            const fName = document.getElementById('first_name')?.value?.trim();
            const lName = document.getElementById('last_name')?.value?.trim();
            const pEmail = document.getElementById('preferred_email')?.value?.trim();
            const pName = document.getElementById('parent_name')?.value?.trim();
            const parEmail = document.getElementById('parent_email')?.value?.trim();
            const pPhone = document.getElementById('parent_phone')?.value?.trim();
            const recName = document.getElementById('recommender_name')?.value?.trim();
            const recEmail = document.getElementById('recommender_email')?.value?.trim();
            const loc = document.getElementById('student_location')?.value;

            const sec1Filled = [fName, lName, pEmail, pName, parEmail, pPhone, recName, recEmail, loc].filter(Boolean).length;
            if (sec1Filled === 9) sectionStatuses.sec1 = 'complete';
            else if (sec1Filled > 0) sectionStatuses.sec1 = 'incomplete';
            else sectionStatuses.sec1 = 'not_started';

            // Sec 2
            const grade = document.getElementById('grade_level')?.value;
            const prog = document.getElementById('programming_experience')?.value;
            const langs = Array.from(document.querySelectorAll('.lang-checkbox:checked'));
            const mls = Array.from(document.querySelectorAll('.ml-checkbox:checked'));
            const res = document.querySelector('input[name="research_experience"]:checked');
            const aid = document.querySelector('input[name="needs_financial_aid"]:checked');
            const clubs = document.getElementById('clubs_activities')?.value?.trim();
            const thoughts = document.getElementById('final_thoughts')?.value?.trim();

            const sec2Filled = [grade, prog, langs.length > 0, mls.length > 0, res, aid, clubs, thoughts].filter(Boolean).length;
            if (sec2Filled === 8) sectionStatuses.sec2 = 'complete';
            else if (sec2Filled > 0) sectionStatuses.sec2 = 'incomplete';
            else sectionStatuses.sec2 = 'not_started';

            // Sec 3: BOTH essays MUST have text to be complete
            const e1 = document.getElementById('essay_one')?.value?.trim() || '';
            const e2 = document.getElementById('essay_two')?.value?.trim() || '';

            if (e1.length > 0 && e2.length > 0) {
                sectionStatuses.sec3 = 'complete';
            } else if (e1.length > 0 || e2.length > 0) {
                sectionStatuses.sec3 = 'incomplete';
            } else {
                sectionStatuses.sec3 = 'not_started';
            }

            // Sec 4: optional, but if you opt in (Yes) you must finish Colab link + every timed question
            const pyExp = document.querySelector('input[name="python_experience"]:checked')?.value;
            const pyAssessment = testPythonAssessment || window.DRAFT_PYTHON_ASSESSMENT || null;
            const pyStatus = pyAssessment?.status || null;
            const exerciseEligible = prog === 'intermediate' || prog === 'advanced';
            const colabLink = document.getElementById('colab_link')?.value?.trim() || '';
            const pyQuestions = pyAssessment?.questions || [];
            const allQuestionsAnswered = pyQuestions.length > 0 && pyQuestions.every((q) => {
                const el = document.getElementById(`python-answer-${q.id}`);
                const ans = el ? el.value : (q.answer || '');
                return String(ans).trim().length > 0;
            });
            const timedDone = pyStatus === 'completed' || pyStatus === 'expired';

            if (!exerciseEligible) {
                sectionStatuses.sec4 = 'complete';
            } else if (pyExp === 'no') {
                sectionStatuses.sec4 = 'complete';
            } else if (pyExp === 'yes' || pyStatus) {
                sectionStatuses.sec4 = (colabLink && timedDone && allQuestionsAnswered) ? 'complete' : 'incomplete';
            } else {
                sectionStatuses.sec4 = 'not_started';
            }

            updateSidebarBubbles();
            populateReviewSummary();
        }

        function updateSidebarBubbles() {
            const statusMap = {
                1: sectionStatuses.sec1,
                2: sectionStatuses.sec2,
                3: sectionStatuses.sec3,
                4: sectionStatuses.sec4,
                5: (sectionStatuses.sec1 === 'complete' && sectionStatuses.sec2 === 'complete' && sectionStatuses.sec3 === 'complete') ? 'complete' : 'incomplete'
            };

            document.querySelectorAll('.sidebar-step-btn').forEach(btn => {
                const s = parseInt(btn.getAttribute('data-step'));
                const bubble = btn.querySelector('.step-num-bubble');
                const title = btn.querySelector('.step-title-text');
                const status = statusMap[s] || 'not_started';

                if (bubble) {
                    if (status === 'complete') {
                        bubble.style.background = '#16A34A';
                        bubble.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
                    } else if (status === 'incomplete') {
                        bubble.style.background = '#D97706';
                        bubble.innerHTML = '<div style="width: 8px; height: 8px; border-radius: 50%; background: #FFFFFF;"></div>';
                    } else {
                        bubble.style.background = '#334155';
                        bubble.innerHTML = '<div style="width: 6px; height: 6px; border-radius: 50%; background: #94A3B8;"></div>';
                    }
                }

                const subText = btn.querySelector('.step-status-subtext');
                if (subText) {
                    if (s === 4) {
                        subText.textContent = status === 'complete' ? 'Complete' : status === 'incomplete' ? 'In Progress' : 'Optional';
                    } else {
                        subText.textContent = status === 'complete' ? 'Complete' : status === 'incomplete' ? 'In Progress' : 'Not Started';
                    }
                }

                if (s === currentStep) {
                    btn.style.background = 'var(--brand-blue-light)';
                    if (title) title.style.color = 'var(--brand-blue)';
                } else {
                    btn.style.background = 'none';
                    if (title) title.style.color = 'var(--slate-800)';
                }
            });
        }

        function populateReviewSummary() {
            const fName = document.getElementById('first_name')?.value?.trim() || '';
            const lName = document.getElementById('last_name')?.value?.trim() || '';
            document.getElementById('rev-student-name').textContent = `${fName} ${lName}`.trim() || 'Not provided';
            document.getElementById('rev-contact-email').textContent = document.getElementById('preferred_email')?.value?.trim() || 'Not provided';

            const loc = document.getElementById('student_location')?.value;
            const locDetail = document.getElementById('location_detail')?.value;
            let displayLoc = 'Massachusetts';
            if (loc === 'out_of_state') displayLoc = locDetail ? `Out of State (${locDetail})` : 'Out of State (US)';
            else if (loc === 'international') displayLoc = locDetail ? `International (${locDetail})` : 'International';
            document.getElementById('rev-location').textContent = loc ? displayLoc : 'Not provided';

            document.getElementById('rev-parent-name').textContent = document.getElementById('parent_name')?.value?.trim() || 'Not provided';
            document.getElementById('rev-parent-email').textContent = document.getElementById('parent_email')?.value?.trim() || 'Not provided';
            document.getElementById('rev-parent-phone').textContent = document.getElementById('parent_phone')?.value?.trim() || 'Not provided';

            document.getElementById('rev-rec-name').textContent = document.getElementById('recommender_name')?.value?.trim() || 'Not provided';
            document.getElementById('rev-rec-email').textContent = document.getElementById('recommender_email')?.value?.trim() || 'Not provided';

            document.getElementById('rev-grade').textContent = document.getElementById('grade_level')?.value || 'Not provided';
            document.getElementById('rev-prog-exp').textContent = document.getElementById('programming_experience')?.value || 'Not provided';

            const aid = document.querySelector('input[name="needs_financial_aid"]:checked')?.value;
            document.getElementById('rev-aid').textContent = aid ? (aid === 'yes' ? 'Yes' : 'No') : 'Not selected';

            const res = document.querySelector('input[name="research_experience"]:checked')?.value;
            document.getElementById('rev-research').textContent = res || 'Not selected';

            const langs = Array.from(document.querySelectorAll('.lang-checkbox:checked')).map(c => c.value);
            document.getElementById('rev-languages').textContent = langs.length ? langs.join(', ') : 'None selected';

            const mls = Array.from(document.querySelectorAll('.ml-checkbox:checked')).map(c => c.value);
            document.getElementById('rev-ml').textContent = mls.length ? mls.join(', ') : 'None selected';

            const e1 = document.getElementById('essay_one')?.value?.trim() || '';
            const e2 = document.getElementById('essay_two')?.value?.trim() || '';
            const w1 = e1 ? e1.split(/\s+/).length : 0;
            const w2 = e2 ? e2.split(/\s+/).length : 0;

            document.getElementById('rev-essay1-status').textContent = e1 ? `Provided (${w1} words)` : 'Empty';
            document.getElementById('rev-essay1-preview').textContent = e1 ? `"${e1.slice(0, 150)}..."` : 'No text entered.';

            document.getElementById('rev-essay2-status').textContent = e2 ? `Provided (${w2} words)` : 'Empty';
            document.getElementById('rev-essay2-preview').textContent = e2 ? `"${e2.slice(0, 150)}..."` : 'No text entered.';

            // Section 4: Python practice preview (only when something was filled out)
            const pySection = document.getElementById('rev-python-section');
            const pyExp = document.querySelector('input[name="python_experience"]:checked')?.value
                || window.DRAFT_PYTHON_EXPERIENCE
                || null;
            const pyAssess = (typeof testPythonAssessment !== 'undefined' && testPythonAssessment)
                || window.DRAFT_PYTHON_ASSESSMENT
                || null;
            const colabLink = document.getElementById('colab_link')?.value?.trim() || '';

            // Prefer live textarea answers if the workspace is still on the page
            const liveAnswers = Array.from(document.querySelectorAll('.python-answer-input')).map((el) => ({
                id: el.getAttribute('data-question-id'),
                answer: (el.value || '').trim(),
            }));
            const questions = (pyAssess?.questions || []).map((q) => {
                const live = liveAnswers.find((a) => a.id === q.id);
                return {
                    ...q,
                    answer: (live?.answer !== undefined && live.answer !== '') ? live.answer : (q.answer || ''),
                };
            });
            const hasAnswers = questions.some((q) => (q.answer || '').trim());
            const hasPythonContent = Boolean(pyExp || pyAssess || colabLink || hasAnswers);

            if (pySection) {
                if (!hasPythonContent) {
                    pySection.style.display = 'none';
                } else {
                    pySection.style.display = 'block';

                    const expEl = document.getElementById('rev-python-exp');
                    const expRow = document.getElementById('rev-python-exp-row');
                    if (pyExp) {
                        if (expRow) expRow.style.display = '';
                        if (expEl) expEl.textContent = pyExp === 'yes' ? 'Yes' : 'No';
                    } else if (expRow) {
                        expRow.style.display = 'none';
                    }

                    const statusEl = document.getElementById('rev-python-status');
                    const statusRow = document.getElementById('rev-python-status-row');
                    const statusLabels = {
                        not_started: 'Not started',
                        in_progress: 'In progress',
                        completed: 'Submitted',
                        skipped: 'Skipped',
                        expired: 'Time expired',
                    };
                    if (pyAssess?.status) {
                        if (statusRow) statusRow.style.display = '';
                        if (statusEl) statusEl.textContent = statusLabels[pyAssess.status] || pyAssess.status;
                    } else if (pyExp === 'no') {
                        if (statusRow) statusRow.style.display = '';
                        if (statusEl) statusEl.textContent = 'Locked (no Python experience)';
                    } else if (statusRow) {
                        statusRow.style.display = 'none';
                    }

                    const colabLinkEl = document.getElementById('rev-colab-link');
                    const colabNoneEl = document.getElementById('rev-colab-none');
                    if (colabLink) {
                        if (colabLinkEl) {
                            colabLinkEl.href = colabLink;
                            colabLinkEl.textContent = colabLink;
                            colabLinkEl.style.display = '';
                        }
                        if (colabNoneEl) colabNoneEl.textContent = '';
                    } else {
                        if (colabLinkEl) {
                            colabLinkEl.removeAttribute('href');
                            colabLinkEl.textContent = '';
                            colabLinkEl.style.display = 'none';
                        }
                        if (colabNoneEl) colabNoneEl.textContent = 'None provided';
                    }

                    const answersEl = document.getElementById('rev-python-answers');
                    if (answersEl) {
                        if (hasAnswers || (pyAssess?.status === 'completed' || pyAssess?.status === 'expired') && questions.length) {
                            answersEl.style.display = 'flex';
                            answersEl.innerHTML = questions.map((q, idx) => {
                                const ans = (q.answer || '').trim();
                                const preview = ans
                                    ? (ans.length > 200 ? `"${ans.slice(0, 200)}…"` : `"${ans}"`)
                                    : 'No answer entered.';
                                return `
                                    <div style="padding-top: 0.5rem; border-top: 1px solid var(--slate-200);">
                                        <strong>Q${idx + 1}</strong>
                                        <p style="font-style: italic; color: var(--slate-600); margin: 0.25rem 0 0; font-size: 0.825rem; max-height: 72px; overflow: hidden; white-space: pre-wrap;">${escapeHtml(preview)}</p>
                                    </div>
                                `;
                            }).join('');
                        } else {
                            answersEl.style.display = 'none';
                            answersEl.innerHTML = '';
                        }
                    }
                }
            }
        }

        function showStep(stepNum) {
            currentStep = stepNum;
            document.getElementById('current_step_input').value = stepNum;

            // Hide all section divs
            document.querySelectorAll('.wizard-section').forEach(sec => {
                sec.style.display = 'none';
            });
            // Show target section
            const targetSec = document.getElementById(`form-section-${stepNum}`);
            if (targetSec) targetSec.style.display = 'block';

            evaluateClientSectionStatuses();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Handle Sidebar & Next/Prev navigation with Native Auto-Save
        document.querySelectorAll('.sidebar-step-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const s = parseInt(this.getAttribute('data-step'));
                saveSectionDraft();
                showStep(s);
            });
        });

        document.querySelectorAll('.goto-step-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const target = parseInt(this.getAttribute('data-target'));
                saveSectionDraft();
                showStep(target);
            });
        });

        // Mutual Exclusion for Checkboxes ("None" handling)
        function handleExclusiveCheckboxes(checkboxClass) {
            const boxes = document.querySelectorAll(`.${checkboxClass}`);
            boxes.forEach(box => {
                box.addEventListener('change', function() {
                    if (this.value === 'None' && this.checked) {
                        boxes.forEach(b => {
                            if (b.value !== 'None') b.checked = false;
                        });
                    } else if (this.value !== 'None' && this.checked) {
                        boxes.forEach(b => {
                            if (b.value === 'None') b.checked = false;
                        });
                    }
                    evaluateClientSectionStatuses();
                });
            });
        }

        // Real-time Word Counter
        function countWords(str) {
            const trimmed = str.trim();
            return trimmed ? trimmed.split(/\s+/).length : 0;
        }

        function updateCounters(textareaId, charId, badgeId) {
            const text = document.getElementById(textareaId).value;
            const charCount = text.length;
            const wordCount = countWords(text);

            document.getElementById(charId).textContent = charCount;

            const badge = document.getElementById(badgeId);
            if (wordCount >= 500 && wordCount <= 750) {
                badge.className = "badge-pill pill-success";
                badge.innerHTML = `Words: <strong>${wordCount}</strong> (Target 500–750 met)`;
            } else if (wordCount > 0) {
                badge.className = "badge-pill pill-warning";
                badge.innerHTML = `Words: <strong>${wordCount}</strong> (Target: 500–750 words)`;
            } else {
                badge.className = "badge-pill pill-neutral";
                badge.innerHTML = `Words: <strong>0</strong> (Target: 500–750 words)`;
            }
            evaluateClientSectionStatuses();
        }

        // Dynamic Location Detail Dropdown
        const locationSelect = document.getElementById('student_location');
        const locationDetailGroup = document.getElementById('location-detail-group');
        const locationDetailLabel = document.getElementById('location-detail-label');
        const locationDetailSelect = document.getElementById('location_detail');

        function updateLocationDetail() {
            const val = locationSelect.value;
            const initialVal = window.INITIAL_LOC_DETAIL || '';

            if (val === 'out_of_state') {
                locationDetailGroup.style.display = 'block';
                locationDetailLabel.textContent = 'Select State *';
                locationDetailSelect.required = true;
                populateOptions(window.US_STATES, initialVal);
            } else if (val === 'international') {
                locationDetailGroup.style.display = 'block';
                locationDetailLabel.textContent = 'Select Country *';
                locationDetailSelect.required = true;
                populateOptions(window.COUNTRIES, initialVal);
            } else {
                locationDetailGroup.style.display = 'none';
                locationDetailSelect.required = false;
                locationDetailSelect.innerHTML = '<option value="">Select option</option>';
            }
            evaluateClientSectionStatuses();
        }

        function populateOptions(list, selectedValue) {
            let html = '<option value="">Select option</option>';
            list.forEach(item => {
                const isSel = (item.toLowerCase() === selectedValue.toLowerCase()) ? 'selected' : '';
                html += `<option value="${item}" ${isSel}>${item}</option>`;
            });
            locationDetailSelect.innerHTML = html;
        }

        locationSelect?.addEventListener('change', updateLocationDetail);

        // Section Draft Save AJAX
        async function saveSectionDraft() {
            const statusDiv = document.getElementById('section-save-status');
            statusDiv.style.color = 'var(--slate-600)';
            statusDiv.textContent = 'Saving draft...';

            try {
                if (window.IS_TEST_MODE) {
                    await new Promise((r) => setTimeout(r, 250));
                    statusDiv.style.color = 'var(--success-green)';
                    statusDiv.textContent = '✓ Section Draft Saved (test mode — not persisted)';
                    evaluateClientSectionStatuses();
                    setTimeout(() => { statusDiv.textContent = ''; }, 3000);
                    return;
                }

                const form = document.getElementById('application-form');
                const formData = new FormData(form);

                const res = await fetch('/api/save-draft', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (res.ok) {
                    statusDiv.style.color = 'var(--success-green)';
                    statusDiv.textContent = '✓ Section Draft Saved';
                    evaluateClientSectionStatuses();
                    setTimeout(() => { statusDiv.textContent = ''; }, 3000);
                } else {
                    throw new Error(data.error || 'Failed to save');
                }
            } catch (err) {
                statusDiv.style.color = '#DC2626';
                statusDiv.textContent = 'Error saving draft';
            }
        }

        document.getElementById('save-current-section-btn')?.addEventListener('click', saveSectionDraft);
        document.querySelectorAll('.save-section-btn').forEach(btn => {
            btn.addEventListener('click', saveSectionDraft);
        });

        document.getElementById('application-form')?.addEventListener('submit', (e) => {
            if (!window.IS_TEST_MODE) return;
            e.preventDefault();
            const status = document.getElementById('test-submit-status');
            if (status) {
                status.style.color = 'var(--success-green)';
                status.textContent = '✓ Test submission succeeded — nothing was written to the database.';
            }
        });

        // --- Optional Python skill assessment (two timed debugging questions) ---
        let pythonTimerId = null;
        let pythonExpiresAt = null;
        let pythonTimedOut = false;

        const TEST_PYTHON_BANK = [
            {
                id: 'off-by-one',
                title: 'Off-by-one in a loop',
                code: `def sum_first_n(numbers, n):
    total = 0
    for i in range(n):
        total += numbers[i]
    return total

print(sum_first_n([1, 2, 3], 5))`,
                prompt: 'What breaks, and why?',
            },
            {
                id: 'modify-while-iterating',
                title: 'Modifying a list while iterating over it',
                code: `nums = [1, 2, 3, 4, 5]
for n in nums:
    if n % 2 == 0:
        nums.remove(n)
print(nums)`,
                prompt: "What's the actual output (it's surprising), and why does this happen?",
            },
            {
                id: 'immutable-string-method',
                title: "Function that doesn't do what it looks like it does",
                code: `def shout(word):
    word.upper()
    return word

print(shout("hello"))`,
                prompt: "What prints? Why doesn't this behave the way it looks like it should?",
            },
            {
                id: 'accumulator-reset',
                title: 'Accumulator reset inside the loop',
                code: `def total_sales(sales):
    for amount in sales:
        total = 0
        total += amount
    return total

print(total_sales([100, 250, 75]))`,
                prompt: 'What does this return, and why is it wrong?',
            },
            {
                id: 'infinite-loop',
                title: 'Infinite loop',
                code: `def countdown(n):
    while n > 0:
        print(n)
    return "Done"`,
                prompt: 'What happens when you run this?',
            },
            {
                id: 'loop-bound-skip',
                title: 'Loop bound skips an element',
                code: `def print_all(items):
    for i in range(len(items) - 1):
        print(items[i])

print_all(["a", "b", "c"])`,
                prompt: "What's printed, and what's missing?",
            },
            {
                id: 'early-return',
                title: 'Early return inside a loop',
                code: `def contains_negative(numbers):
    for n in numbers:
        if n < 0:
            return True
        else:
            return False
    return False

print(contains_negative([5, 3, -2, 8]))`,
                prompt: 'What does this return? Why is it wrong even though `-2` is in the list?',
            },
            {
                id: 'wrong-logical-op',
                title: 'Wrong logical operator',
                code: `def is_child_or_senior(age):
    if age < 12 and age > 65:
        return True
    return False

print(is_child_or_senior(8))
print(is_child_or_senior(70))`,
                prompt: 'What does this return for both calls? What\'s the logic error?',
            },
        ];

        function pickTestPythonQuestions() {
            const shuffled = [...TEST_PYTHON_BANK].sort(() => Math.random() - 0.5);
            return shuffled.slice(0, 2).map((q) => ({ ...q }));
        }

        function formatPythonTimer(seconds) {
            const m = Math.floor(Math.max(0, seconds) / 60);
            const s = Math.max(0, seconds) % 60;
            return `${m}:${String(s).padStart(2, '0')}`;
        }

        function setPythonStatus(msg) {
            const el = document.getElementById('python-test-status');
            if (el) el.textContent = msg || '';
        }

        function syncPythonGateVisibility() {
            const prog = document.getElementById('programming_experience')?.value;
            const gate = document.getElementById('python-assessment-gate');
            const offer = document.getElementById('python-test-offer');
            const notApplicable = document.getElementById('python-assessment-not-applicable');
            const colabSection = document.getElementById('python-colab-section');
            const blocked = document.getElementById('python-experience-blocked');
            if (!gate) return;

            const show = prog === 'intermediate' || prog === 'advanced';
            gate.style.display = show ? 'block' : 'none';
            if (notApplicable) notApplicable.style.display = show ? 'none' : 'block';

            if (!show) {
                if (offer) offer.style.display = 'none';
                if (blocked) blocked.style.display = 'none';
                if (colabSection) colabSection.style.display = 'block';
                return;
            }

            const pyYes = document.getElementById('python_experience_yes')?.checked;
            const pyNo = document.getElementById('python_experience_no')?.checked;
            if (offer) offer.style.display = pyYes ? 'block' : 'none';
            if (blocked) blocked.style.display = pyNo ? 'block' : 'none';
            // Yes unlocks Colab; No (or unanswered) locks the rest of the section
            if (colabSection) colabSection.style.display = pyYes ? 'block' : 'none';
        }

        function stopPythonTimer() {
            if (pythonTimerId) {
                clearInterval(pythonTimerId);
                pythonTimerId = null;
            }
        }

        function setPythonAnswersReadOnly(readOnly) {
            document.querySelectorAll('.python-answer-input').forEach((el) => {
                el.readOnly = Boolean(readOnly);
            });
            const submitBtn = document.getElementById('python-submit-answers-btn');
            if (submitBtn) submitBtn.disabled = Boolean(readOnly);
        }

        function startPythonTimer(startedAtIso, timeLimitSeconds) {
            stopPythonTimer();
            const startedMs = startedAtIso ? new Date(startedAtIso).getTime() : Date.now();
            const limit = (timeLimitSeconds || 600) * 1000;
            pythonExpiresAt = startedMs + limit;
            pythonTimedOut = false;

            const tick = () => {
                const remaining = Math.ceil((pythonExpiresAt - Date.now()) / 1000);
                const timerEl = document.getElementById('python-timer');
                if (timerEl) timerEl.textContent = formatPythonTimer(remaining);

                if (remaining <= 0) {
                    pythonTimedOut = true;
                    stopPythonTimer();
                    if (timerEl) timerEl.textContent = '0:00';
                    setPythonStatus('Time is up. You can still submit the answers you have.');
                }
            };

            tick();
            pythonTimerId = setInterval(tick, 1000);
        }

        function escapeHtml(str) {
            return String(str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function renderPythonQuestions(questions, readOnly) {
            const container = document.getElementById('python-questions-container');
            if (!container) return;

            container.innerHTML = (questions || []).map((q, idx) => `
                <div class="python-question-block" data-question-id="${escapeHtml(q.id)}" style="margin-bottom: 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid var(--slate-200);">
                    <div style="font-size: 0.95rem; font-weight: 700; color: var(--slate-900); margin-bottom: 0.5rem;">
                        Question ${idx + 1}
                    </div>
                    <pre style="background: #0F172A; color: #E2E8F0; padding: 0.85rem; border-radius: var(--radius-sm); font-size: 0.8rem; overflow-x: auto; white-space: pre-wrap; margin: 0 0 0.65rem 0; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">${escapeHtml(q.code)}</pre>
                    <p style="font-size: 0.9rem; color: var(--slate-800); line-height: 1.5; margin-bottom: 0.5rem; font-weight: 600;">
                        ${escapeHtml(q.prompt)}
                    </p>
                    <label class="form-label" for="python-answer-${escapeHtml(q.id)}">Your answer</label>
                    <textarea
                        id="python-answer-${escapeHtml(q.id)}"
                        class="textarea-field python-answer-input"
                        data-question-id="${escapeHtml(q.id)}"
                        rows="4"
                        maxlength="3000"
                        placeholder="Explain what happens and why…"
                        ${readOnly ? 'readonly' : ''}
                    ></textarea>
                </div>
            `).join('');

            (questions || []).forEach((q) => {
                const el = document.getElementById(`python-answer-${q.id}`);
                if (el) el.value = q.answer || '';
            });
        }

        function collectPythonAnswers() {
            return Array.from(document.querySelectorAll('.python-answer-input')).map((el) => ({
                id: el.getAttribute('data-question-id'),
                answer: el.value || '',
            }));
        }

        function showPythonWorkspace(assessment, readOnly) {
            const workspace = document.getElementById('python-test-workspace');
            const actions = document.getElementById('python-test-actions');
            const offer = document.getElementById('python-test-offer');
            if (offer) offer.style.display = 'block';
            if (workspace) workspace.style.display = 'block';

            const done = assessment.status === 'completed' || assessment.status === 'expired' || assessment.status === 'skipped';
            const hideStart = done || readOnly;
            if (actions) actions.style.display = hideStart ? 'none' : 'flex';

            const locked = Boolean(readOnly) || assessment.status === 'completed' || assessment.status === 'expired';
            renderPythonQuestions(assessment.questions || [], locked);
            setPythonAnswersReadOnly(locked);

            if (assessment.status === 'in_progress' && assessment.started_at && !locked) {
                startPythonTimer(assessment.started_at, assessment.time_limit_seconds || 600);
            } else {
                stopPythonTimer();
                const timerEl = document.getElementById('python-timer');
                if (timerEl && (assessment.status === 'completed' || assessment.status === 'expired')) {
                    timerEl.textContent = assessment.status === 'expired' ? 'Expired' : 'Done';
                }
            }
        }

        async function startPythonAssessment() {
            const startBtn = document.getElementById('python-test-start-btn');
            if (startBtn) startBtn.disabled = true;
            setPythonStatus('Starting exercise…');
            try {
                if (window.IS_TEST_MODE) {
                    testPythonAssessment = {
                        status: 'in_progress',
                        questions: pickTestPythonQuestions(),
                        started_at: new Date().toISOString(),
                        time_limit_seconds: 600,
                    };
                    showPythonWorkspace(testPythonAssessment, false);
                    setPythonStatus('Answer both questions, then submit. (test mode — not persisted)');
                    evaluateClientSectionStatuses();
                    return;
                }

                const res = await fetch('/api/python-assessment/start', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'start', pythonExperience: 'yes' })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Failed to start assessment');
                window.DRAFT_PYTHON_ASSESSMENT = data.assessment;
                showPythonWorkspace(data.assessment, false);
                setPythonStatus('Answer both questions, then submit.');
                evaluateClientSectionStatuses();
            } catch (err) {
                console.error(err);
                setPythonStatus(err.message || 'Could not start the exercise.');
                if (startBtn) startBtn.disabled = false;
            }
        }

        async function skipPythonAssessment() {
            setPythonStatus('Skipping…');
            try {
                if (window.IS_TEST_MODE) {
                    testPythonAssessment = { status: 'skipped' };
                    document.getElementById('python-test-workspace').style.display = 'none';
                    document.getElementById('python-test-actions').style.display = 'none';
                    stopPythonTimer();
                    setPythonStatus('Python exercise skipped (test mode — not persisted).');
                    evaluateClientSectionStatuses();
                    return;
                }

                const res = await fetch('/api/python-assessment/start', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'skip', pythonExperience: 'yes' })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Failed to skip');
                window.DRAFT_PYTHON_ASSESSMENT = data.assessment || { status: 'skipped' };
                document.getElementById('python-test-workspace').style.display = 'none';
                document.getElementById('python-test-actions').style.display = 'none';
                stopPythonTimer();
                setPythonStatus('Python exercise skipped. You can continue your application.');
                evaluateClientSectionStatuses();
            } catch (err) {
                console.error(err);
                setPythonStatus(err.message || 'Could not skip.');
            }
        }

        async function submitPythonAnswers() {
            const submitBtn = document.getElementById('python-submit-answers-btn');
            const answers = collectPythonAnswers();
            const allFilled = answers.length > 0 && answers.every((a) => a.answer.trim());
            if (!allFilled && !pythonTimedOut) {
                setPythonStatus('Please answer every question before submitting.');
                return;
            }

            if (submitBtn) submitBtn.disabled = true;
            setPythonStatus('Submitting answers…');
            try {
                if (window.IS_TEST_MODE) {
                    stopPythonTimer();
                    setPythonAnswersReadOnly(true);
                    if (testPythonAssessment) {
                        testPythonAssessment.status = pythonTimedOut ? 'expired' : 'completed';
                        testPythonAssessment.questions = (testPythonAssessment.questions || []).map((q) => {
                            const found = answers.find((a) => a.id === q.id);
                            return { ...q, answer: found ? found.answer : '' };
                        });
                        testPythonAssessment.submitted_at = new Date().toISOString();
                    }
                    setPythonStatus('Python assessment complete (test mode — not persisted).');
                    const timerEl = document.getElementById('python-timer');
                    if (timerEl) timerEl.textContent = pythonTimedOut ? 'Expired' : 'Done';
                    evaluateClientSectionStatuses();
                    return;
                }

                const res = await fetch('/api/python-assessment/submit-answers', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ answers, expired: pythonTimedOut })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Failed to submit answers');

                stopPythonTimer();
                setPythonAnswersReadOnly(true);
                window.DRAFT_PYTHON_ASSESSMENT = data.assessment || window.DRAFT_PYTHON_ASSESSMENT;
                if (window.DRAFT_PYTHON_ASSESSMENT) {
                    window.DRAFT_PYTHON_ASSESSMENT.status = pythonTimedOut ? 'expired' : 'completed';
                }
                setPythonStatus('Python assessment complete. Thank you!');
                const timerEl = document.getElementById('python-timer');
                if (timerEl) timerEl.textContent = pythonTimedOut ? 'Expired' : 'Done';
                evaluateClientSectionStatuses();
            } catch (err) {
                console.error(err);
                setPythonStatus(err.message || 'Submit failed.');
                if (submitBtn) submitBtn.disabled = false;
            }
        }

        function initPythonAssessmentUI() {
            const progSelect = document.getElementById('programming_experience');
            progSelect?.addEventListener('change', syncPythonGateVisibility);

            document.querySelectorAll('input[name="python_experience"]').forEach((radio) => {
                radio.addEventListener('change', syncPythonGateVisibility);
            });

            document.getElementById('python-test-start-btn')?.addEventListener('click', startPythonAssessment);
            document.getElementById('python-test-skip-btn')?.addEventListener('click', skipPythonAssessment);
            document.getElementById('python-submit-answers-btn')?.addEventListener('click', submitPythonAnswers);

            syncPythonGateVisibility();

            const existing = window.DRAFT_PYTHON_ASSESSMENT;
            if (existing && (existing.status === 'in_progress' || existing.status === 'completed' || existing.status === 'expired')) {
                // Legacy coding assessments won't have questions[]; skip resume if so
                if (!existing.questions?.length) {
                    setPythonStatus('A previous coding exercise was started under an older format and cannot be resumed. You can skip or continue the rest of your application.');
                    return;
                }
                const yesRadio = document.getElementById('python_experience_yes');
                if (yesRadio) yesRadio.checked = true;
                syncPythonGateVisibility();
                showPythonWorkspace(existing, existing.status === 'completed' || existing.status === 'expired');
                if (existing.status === 'completed' || existing.status === 'expired') {
                    setPythonStatus('Previous Python assessment loaded.');
                } else {
                    setPythonStatus('Continuing your in-progress Python exercise.');
                }
            } else if (existing && existing.status === 'skipped') {
                const yesRadio = document.getElementById('python_experience_yes');
                if (yesRadio) yesRadio.checked = true;
                syncPythonGateVisibility();
                document.getElementById('python-test-actions').style.display = 'none';
                setPythonStatus('Python exercise previously skipped.');
            }
        }

        // Add real-time input listeners to all form fields
        document.querySelectorAll('input, select, textarea').forEach(input => {
            input.addEventListener('change', evaluateClientSectionStatuses);
            input.addEventListener('input', evaluateClientSectionStatuses);
        });

        document.addEventListener('DOMContentLoaded', () => {
            const fpInput = document.getElementById('applicant_device_fp_input');
            if (fpInput) fpInput.value = getDeviceFingerprint();

            showStep(currentStep);
            updateLocationDetail();
            handleExclusiveCheckboxes('lang-checkbox');
            handleExclusiveCheckboxes('ml-checkbox');
            initPythonAssessmentUI();

            ['essay_one', 'essay_two'].forEach((id, idx) => {
                const charId = idx === 0 ? 'essay-one-chars' : 'essay-two-chars';
                const wordId = idx === 0 ? 'essay-one-words' : 'essay-two-words';
                const badgeId = idx === 0 ? 'essay-one-words-badge' : 'essay-two-words-badge';
                
                const el = document.getElementById(id);
                if (el) {
                    updateCounters(id, charId, wordId, badgeId);
                    el.addEventListener('input', () => updateCounters(id, charId, wordId, badgeId));
                }
            });

            evaluateClientSectionStatuses();
        });
    </script>
</Layout>
