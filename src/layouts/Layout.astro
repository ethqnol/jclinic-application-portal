---
import '../styles/global.css';

export interface Props {
	title: string;
	session?: any;
	userRole?: string;
}

const { title, session, userRole } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="MIT Jameel Clinic Summer Bootcamp Application Portal" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Security Headers & Meta Policies -->
		<meta http-equiv="X-Content-Type-Options" content="nosniff" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none';" />

		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="header-container">
				<div class="header-left">
					<a href="/" class="header-brand">
						<img src="/jclinic_log.svg" alt="MIT Jameel Clinic" class="header-logo" />
						<div class="header-title">
							<h1 class="site-title">MIT Jameel Clinic</h1>
							<span class="site-subtitle">Summer Bootcamp Application Portal</span>
						</div>
					</a>
				</div>
				<div class="header-right">
					{session ? (
						<div class="header-user">
							<div class="user-info">
								<span class="user-name">
									{session.user.name}
								</span>
								{userRole === 'admin' && (
									<span class="user-badge badge-admin">Admin</span>
								)}
							</div>
							<div class="user-actions">
								{userRole === 'admin' ? (
									<a href="/admin" class="btn btn-secondary btn-sm">
										Admin Console
									</a>
								) : (
									<a href="/dashboard" class="btn btn-secondary btn-sm">
										Dashboard
									</a>
								)}
								<form method="POST" action="/api/auth/logout" class="logout-form">
									<button type="submit" class="btn btn-secondary btn-sm">
										Logout
									</button>
								</form>
							</div>
						</div>
					) : (
						<div class="header-actions">
							<a href="/api/auth/google" class="btn btn-primary btn-sm">
								Sign In
							</a>
						</div>
					)}
				</div>
			</div>
		</header>
		
		<main class="main-content-wrapper">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-container">
				<p class="footer-text">MIT Jameel Clinic Summer Bootcamp Application Portal</p>
				<p class="footer-subtext">
					Massachusetts Institute of Technology
				</p>
			</div>
		</footer>
	</body>
</html>